<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="Acesso da equipe"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid Padding="24">
        <VerticalStackLayout
            HorizontalOptions="Center"
            MaximumWidthRequest="400"
            Spacing="24"
            VerticalOptions="Center"
            WidthRequest="400">

            <VerticalStackLayout Spacing="14">
                <Border HorizontalOptions="Start" Style="{StaticResource MzLogo}">
                    <Label Style="{StaticResource MzLogoLabel}" Text="{Binding Theme.Initial}" />
                </Border>
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource MzPageTitle}" Text="Acesso da equipe" />
                    <Label Style="{StaticResource MzMuted}" Text="Entre com o usuário fornecido pela gerência." />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border Padding="24" Style="{StaticResource MzCard}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource MzFieldLabel}" Text="Usuário" />
                        <Border Style="{StaticResource MzInput}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <controls:MzIcon Color="{DynamicResource MzTextSubtle}" Name="user" Size="16" />
                                <Entry
                                    x:Name="UsernameEntry"
                                    Grid.Column="1"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    Keyboard="Plain"
                                    Placeholder="Nome de usuário"
                                    ReturnType="Next"
                                    Text="{Binding Username}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource MzFieldLabel}" Text="Senha" />
                        <Border Style="{StaticResource MzInput}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <controls:MzIcon Color="{DynamicResource MzTextSubtle}" Name="lock" Size="16" />
                                <Entry
                                    Grid.Column="1"
                                    IsPassword="True"
                                    Placeholder="Senha"
                                    ReturnCommand="{Binding LoginCommand}"
                                    ReturnType="Go"
                                    Text="{Binding Password}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <controls:AlertBanner Kind="Error" Text="{Binding ErrorMessage}" />

                    <controls:MzButton
                        Command="{Binding LoginCommand}"
                        HorizontalOptions="Fill"
                        Icon="log-in"
                        IsLoading="{Binding IsBusy}"
                        Size="48"
                        Text="Entrar"
                        Variant="Primary" />
                </VerticalStackLayout>
            </Border>

            <controls:MzButton
                Command="{Binding CancelCommand}"
                HorizontalOptions="Center"
                Icon="arrow-left"
                Text="Voltar ao cardápio"
                Variant="Ghost" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
