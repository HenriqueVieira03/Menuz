<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.KitchenPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:KitchenViewModel"
    Title="Cozinha"
    Shell.NavBarIsVisible="False">

    <!-- A tela tem o próprio botão de voltar; esconde a seta extra que o Windows mostra na barra de título -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">

        <!-- Barra superior -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Style="{StaticResource MzAppBar}">
            <Button
                Command="{Binding GoBackCommand}"
                Style="{StaticResource MzQtyButton}"
                Text="←"
                VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Style="{StaticResource MzTitle}" Text="Cozinha" />
                <HorizontalStackLayout Spacing="10">
                    <!-- Indicador de conexão em tempo real -->
                    <Border Style="{StaticResource MzBadge}">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" TargetType="Border" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource MzSuccessTint}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Style="{StaticResource MzBadgeLabel}" Text="{Binding ConnectionText}">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource MzSuccessText}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Label Style="{StaticResource MzMuted}" Text="{Binding LastSyncText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button
                Grid.Column="2"
                Command="{Binding SyncCommand}"
                Style="{StaticResource MzOutlineButton}"
                Text="⟳  Sincronizar"
                VerticalOptions="Center" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <!-- Mensagem de erro -->
        <Border
            Grid.Row="2"
            Margin="24,14,24,0"
            Padding="14,10"
            BackgroundColor="{StaticResource MzDestructiveTint}"
            IsVisible="{Binding HasError}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Label Style="{StaticResource MzError}" Text="{Binding ErrorMessage}" />
        </Border>

        <Grid Grid.Row="3">
            <CollectionView
                x:Name="OrdersList"
                Margin="20,16,20,0"
                ItemSizingStrategy="MeasureAllItems"
                ItemsSource="{Binding Orders}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        x:Name="OrdersLayout"
                        HorizontalItemSpacing="16"
                        Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                            HeightRequest="88"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="88">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="44" />
                            </Border.StrokeShape>
                            <Label FontSize="40" HorizontalOptions="Center" Text="🍳" VerticalOptions="Center" />
                        </Border>
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource MzSection}"
                            Text="Nenhum pedido no momento" />
                        <Label
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource MzMuted}"
                            Text="Os pedidos aparecem aqui automaticamente assim que o cliente envia." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="40" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderCardViewModel">
                        <Border
            Padding="0"
            HeightRequest="400"
            Style="{StaticResource MzCard}">
                            <Grid RowDefinitions="5,Auto,Auto,*,Auto">

                                <!-- Faixa de cor do status -->
                                <BoxView Grid.Row="0" Color="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}">
                                    <BoxView.Triggers>
                                        <DataTrigger Binding="{Binding IsPreparing}" TargetType="BoxView" Value="True">
                                            <Setter Property="Color" Value="#E9A23B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsReady}" TargetType="BoxView" Value="True">
                                            <Setter Property="Color" Value="{StaticResource MzSuccess}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <!-- Cabeçalho (fixo) -->
                                <Grid
                    Grid.Row="1"
                    Padding="18,14,18,12"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Style="{StaticResource MzTitle}" Text="{Binding Title}" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Style="{StaticResource MzMuted}" Text="{Binding Subtitle}" />
                                    </VerticalStackLayout>

                                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                        Style="{StaticResource MzBadge}"
                        VerticalOptions="Start">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsPreparing}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzWarningTint}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReady}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzSuccessTint}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label
                            Style="{StaticResource MzBadgeLabel}"
                            Text="{Binding StatusText}"
                            TextColor="{StaticResource MzPrimaryDeep}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsPreparing}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzWarningText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsReady}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzSuccessText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                                <BoxView Grid.Row="2" Margin="18,0" Style="{StaticResource MzDivider}" />

                                <!-- Itens (rolam quando não cabem) -->
                                <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Default">
                                    <VerticalStackLayout
                        Padding="18,12"
                        BindableLayout.ItemsSource="{Binding Lines}"
                        Spacing="12">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OrderLineViewModel">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Text}" />
                                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        IsVisible="{Binding HasDetails}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Details}"
                                        TextColor="{StaticResource MzPrimaryDeep}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </ScrollView>

                                <!-- Rodapé (fixo): total + botão -->
                                <VerticalStackLayout Grid.Row="4" Padding="18,0,18,18" Spacing="12">
                                    <BoxView Style="{StaticResource MzDivider}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource MzMuted}" Text="Total do pedido" VerticalOptions="Center" />
                                        <Label
                            Grid.Column="1"
                            Style="{StaticResource MzPrice}"
                            Text="{Binding Total, StringFormat='{0:C2}'}" />
                                    </Grid>
                                    <Button
                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AdvanceCommand}"
                        CommandParameter="{Binding .}"
                        HeightRequest="50"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="{Binding ActionText}">
                                        <Button.Triggers>
                                            <DataTrigger Binding="{Binding IsReady}" TargetType="Button" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzSuccess}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                Margin="0,24,0,0"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>
