<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.KitchenPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:KitchenViewModel"
    Title="Cozinha"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Barra superior -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Style="{StaticResource MzAppBar}">
            <controls:MzButton Command="{Binding GoBackCommand}" Icon="arrow-left" Variant="Outline" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzSection}" Text="Cozinha" />
                <Label Style="{StaticResource MzCaption}" Text="{Binding LastSyncText}" />
            </VerticalStackLayout>

            <!-- Conexão em tempo real -->
            <Border
                Grid.Column="2"
                Padding="10,5"
                BackgroundColor="{DynamicResource MzSurfaceAlt}"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <Border.Triggers>
                    <DataTrigger Binding="{Binding IsLive}" TargetType="Border" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource MzSuccessSoft}" />
                    </DataTrigger>
                </Border.Triggers>
                <HorizontalStackLayout Spacing="6">
                    <Ellipse
                        Fill="{DynamicResource MzTextSubtle}"
                        HeightRequest="8"
                        VerticalOptions="Center"
                        WidthRequest="8">
                        <Ellipse.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" TargetType="Ellipse" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource MzSuccess}" />
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="12"
                        Text="{Binding ConnectionText}"
                        TextColor="{DynamicResource MzTextMuted}">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource MzSuccessText}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </Border>

            <controls:MzButton
                Grid.Column="3"
                Command="{Binding SyncCommand}"
                Icon="refresh"
                Text="Sincronizar"
                Variant="Outline" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <controls:AlertBanner
            Grid.Row="2"
            Margin="24,16,24,0"
            Kind="Error"
            Text="{Binding ErrorMessage}" />

        <Grid Grid.Row="3">
            <CollectionView
                x:Name="OrdersList"
                Margin="24,16,24,0"
                ItemSizingStrategy="MeasureAllItems"
                ItemsSource="{Binding Orders}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        x:Name="OrdersLayout"
                        HorizontalItemSpacing="16"
                        Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        MaximumWidthRequest="360"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Border Style="{StaticResource MzEmptyIcon}">
                            <controls:MzIcon Color="{DynamicResource MzTextMuted}" Name="inbox" Size="26" />
                        </Border>
                        <Label HorizontalOptions="Center" Style="{StaticResource MzSection}" Text="Nenhum pedido no momento" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource MzMuted}"
                            Text="Os pedidos aparecem aqui automaticamente assim que o cliente envia." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>

                <!--
                    Altura fixa: no Windows a grade usa a mesma altura para todos os cartões,
                    então pedidos grandes rolam dentro do próprio cartão (ajuste do Rafael).
                -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderCardViewModel">
                        <Border
                            Padding="0"
                            HeightRequest="400"
                            Style="{StaticResource MzCard}">
                            <Grid RowDefinitions="4,Auto,Auto,*,Auto">

                                <!-- Faixa de status -->
                                <BoxView Color="{DynamicResource MzPrimary}">
                                    <BoxView.Triggers>
                                        <DataTrigger Binding="{Binding IsPreparing}" TargetType="BoxView" Value="True">
                                            <Setter Property="Color" Value="{DynamicResource MzWarning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsReady}" TargetType="BoxView" Value="True">
                                            <Setter Property="Color" Value="{DynamicResource MzSuccess}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <!-- Cabeçalho -->
                                <Grid
                                    Grid.Row="1"
                                    Padding="18,14,18,12"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Style="{StaticResource MzTitle}"
                                            Text="{Binding Title}" />
                                        <Label Style="{StaticResource MzCaption}" Text="{Binding Subtitle}" />
                                    </VerticalStackLayout>
                                    <controls:StatusBadge
                                        Grid.Column="1"
                                        Status="{Binding Status}"
                                        VerticalOptions="Start" />
                                </Grid>

                                <BoxView Grid.Row="2" Margin="18,0" Style="{StaticResource MzDivider}" />

                                <!-- Itens (rolam quando não cabem) -->
                                <ScrollView Grid.Row="3">
                                    <VerticalStackLayout
                                        Padding="18,12"
                                        BindableLayout.ItemsSource="{Binding Lines}"
                                        Spacing="12">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OrderLineViewModel">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="16"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding Text}" />
                                                    <!-- Escolhas do cliente: destacadas para a cozinha não deixar passar -->
                                                    <Label
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="14"
                                                        IsVisible="{Binding HasDetails}"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding Details}"
                                                        TextColor="{DynamicResource MzPrimaryStrong}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </ScrollView>

                                <!-- Rodapé: total + ação -->
                                <VerticalStackLayout Grid.Row="4" Padding="18,0,18,18" Spacing="12">
                                    <BoxView Style="{StaticResource MzDivider}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource MzMuted}" Text="Total do pedido" VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource MzPrice}"
                                            Text="{Binding Total, StringFormat='{0:C2}'}" />
                                    </Grid>
                                    <controls:MzButton
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AdvanceCommand}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="Fill"
                                        Size="48"
                                        Text="{Binding ActionText}"
                                        Variant="Primary" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                Margin="0,24,0,0"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>
