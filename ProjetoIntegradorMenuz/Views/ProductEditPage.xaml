<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.ProductEditPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:models="clr-namespace:ProjetoIntegradorMenuz.Models"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:ProductEditViewModel"
    Title="{Binding PageTitle}"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Style="{StaticResource MzAppBar}">
            <controls:MzButton Command="{Binding CancelCommand}" Icon="arrow-left" Variant="Outline" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzCaption}" Text="Cardápio" />
                <Label Style="{StaticResource MzSection}" Text="{Binding PageTitle}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="32,24" MaximumWidthRequest="960" Spacing="16">

                <!-- Informações -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Informações" />
                            <Label Style="{StaticResource MzMuted}" Text="Como o produto aparece no cardápio do cliente." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="Nome" />
                                <Border Style="{StaticResource MzInput}">
                                    <Entry MaxLength="120" Placeholder="Ex.: X-Burger" Text="{Binding Name}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="Descrição" />
                                <Border Padding="8,4" Style="{StaticResource MzInput}">
                                    <Editor
                                        AutoSize="TextChanges"
                                        MaxLength="500"
                                        MinimumHeightRequest="76"
                                        Placeholder="Ingredientes, porção, acompanhamentos"
                                        Text="{Binding Description}" />
                                </Border>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource MzFieldLabel}" Text="Preço base" />
                                    <Border Style="{StaticResource MzInput}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Label Style="{StaticResource MzMuted}" Text="R$" VerticalOptions="Center" />
                                            <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="0,00" Text="{Binding PriceText}" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource MzFieldLabel}" Text="Categoria" />
                                    <Border Style="{StaticResource MzInput}">
                                        <Picker
                                            ItemDisplayBinding="{Binding Name, x:DataType=models:CategoryAdmin}"
                                            ItemsSource="{Binding Categories}"
                                            SelectedItem="{Binding SelectedCategory}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource MzFieldLabel}" Text="Disponível no cardápio" />
                                    <Label Style="{StaticResource MzCaption}" Text="Desligado, o produto some dos tablets das mesas." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsAvailable}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Foto -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Foto" />
                            <Label Style="{StaticResource MzMuted}" Text="JPG, PNG ou WEBP de até 5 MB, ou o link de uma imagem." />
                        </VerticalStackLayout>
                        <Grid Grid.Column="1" ColumnDefinitions="200,*" ColumnSpacing="20">
                            <Border
                                BackgroundColor="{DynamicResource MzSurfaceAlt}"
                                HeightRequest="140"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid>
                                    <controls:MzIcon
                                        Color="{DynamicResource MzTextSubtle}"
                                        IsVisible="{Binding HasNoImage}"
                                        Name="image"
                                        Size="28" />
                                    <Image Aspect="AspectFill" IsVisible="{Binding HasImage}" Source="{Binding ImagePreview}" />
                                    <ActivityIndicator
                                        HorizontalOptions="Center"
                                        IsRunning="{Binding IsUploading}"
                                        IsVisible="{Binding IsUploading}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <controls:MzButton
                                        Command="{Binding PickImageCommand}"
                                        Icon="upload"
                                        Text="Enviar arquivo"
                                        Variant="Outline" />
                                    <controls:MzButton
                                        Command="{Binding RemoveImageCommand}"
                                        Icon="trash"
                                        IsVisible="{Binding HasImage}"
                                        Text="Remover"
                                        Variant="Ghost" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource MzFieldLabel}" Text="Ou link da imagem" />
                                    <Border Style="{StaticResource MzInput}">
                                        <Entry Keyboard="Url" MaxLength="500" Placeholder="https://" Text="{Binding ImageLink}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tamanhos -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Tamanhos" />
                            <Label Style="{StaticResource MzMuted}" Text="Opcional. O cliente escolhe um; o acréscimo é somado ao preço base." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sizes}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditableOptionViewModel">
                                        <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="10">
                                            <Border Style="{StaticResource MzInput}">
                                                <Entry MaxLength="60" Placeholder="Nome (ex.: Grande)" Text="{Binding Name}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource MzInput}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <Label Style="{StaticResource MzMuted}" Text="+ R$" VerticalOptions="Center" />
                                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="0,00" Text="{Binding PriceText}" />
                                                </Grid>
                                            </Border>
                                            <controls:MzButton
                                                Grid.Column="2"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveOptionCommand}"
                                                CommandParameter="{Binding .}"
                                                Icon="x"
                                                Variant="Ghost" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <controls:MzButton Command="{Binding AddSizeCommand}" Icon="plus" Text="Adicionar tamanho" Variant="Subtle" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Adicionais -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Adicionais" />
                            <Label Style="{StaticResource MzMuted}" Text="Extras que o cliente pode marcar. Preço 0 aparece como grátis." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Addons}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditableOptionViewModel">
                                        <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="10">
                                            <Border Style="{StaticResource MzInput}">
                                                <Entry MaxLength="60" Placeholder="Nome (ex.: Bacon)" Text="{Binding Name}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource MzInput}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <Label Style="{StaticResource MzMuted}" Text="R$" VerticalOptions="Center" />
                                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="0,00" Text="{Binding PriceText}" />
                                                </Grid>
                                            </Border>
                                            <controls:MzButton
                                                Grid.Column="2"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveOptionCommand}"
                                                CommandParameter="{Binding .}"
                                                Icon="x"
                                                Variant="Ghost" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <controls:MzButton Command="{Binding AddAddonCommand}" Icon="plus" Text="Adicionar adicional" Variant="Subtle" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Ingredientes -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Ingredientes" />
                            <Label Style="{StaticResource MzMuted}" Text="Marque como removível o que o cliente pode pedir sem." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditableOptionViewModel">
                                        <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="10">
                                            <Border Style="{StaticResource MzInput}">
                                                <Entry MaxLength="60" Placeholder="Nome (ex.: Cebola)" Text="{Binding Name}" />
                                            </Border>
                                            <Border Grid.Column="1" Padding="6,0,12,0" Style="{StaticResource MzInput}">
                                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <CheckBox IsChecked="{Binding IsRemovable}" VerticalOptions="Center" />
                                                    <Label Style="{StaticResource MzBody}" Text="Removível" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <controls:MzButton
                                                Grid.Column="2"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveOptionCommand}"
                                                CommandParameter="{Binding .}"
                                                Icon="x"
                                                Variant="Ghost" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <controls:MzButton Command="{Binding AddIngredientCommand}" Icon="plus" Text="Adicionar ingrediente" Variant="Subtle" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rodapé -->
        <BoxView Grid.Row="3" Style="{StaticResource MzDivider}" />
        <Grid
            Grid.Row="4"
            Padding="32,12"
            BackgroundColor="{DynamicResource MzSurface}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="12">
            <controls:MzButton
                Command="{Binding DeleteCommand}"
                Icon="trash"
                IsVisible="{Binding IsExisting}"
                Text="Excluir produto"
                Variant="Danger" />
            <controls:AlertBanner
                Grid.Column="1"
                Kind="Error"
                Text="{Binding ErrorMessage}"
                VerticalOptions="Center" />
            <controls:MzButton Grid.Column="2" Command="{Binding CancelCommand}" Text="Cancelar" Variant="Outline" />
            <controls:MzButton
                Grid.Column="3"
                Command="{Binding SaveCommand}"
                Icon="check"
                IsLoading="{Binding IsBusy}"
                Text="Salvar produto"
                Variant="Primary" />
        </Grid>
    </Grid>
</ContentPage>
