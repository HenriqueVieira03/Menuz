<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.CloseBillPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:CloseBillViewModel"
    Title="Fechar conta"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Style="{StaticResource MzAppBar}">
            <controls:MzButton Command="{Binding GoBackCommand}" Icon="arrow-left" Variant="Outline" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzSection}" Text="Fechar conta" />
                <Label Style="{StaticResource MzCaption}" Text="{Binding HeaderText}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <Grid Grid.Row="2">
            <ScrollView IsVisible="{Binding HasBill}">
                <VerticalStackLayout Padding="24" HorizontalOptions="Center" Spacing="16">
                    <controls:AlertBanner Kind="Error" Text="{Binding ErrorMessage}" />
                    <controls:AlertBanner Kind="Warning" Text="{Binding NoticeText}" />

                    <!-- Recibo -->
                    <Border
                        x:Name="ReceiptHost"
                        Padding="0"
                        Style="{StaticResource MzCard}">
                        <VerticalStackLayout>
                            <Grid Padding="20,16" ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource MzSection}" Text="Resumo da conta" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource MzCaption}"
                                    Text="{Binding HeaderText}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BillOrderSummaryViewModel">
                                        <VerticalStackLayout>
                                            <BoxView Style="{StaticResource MzDivider}" />
                                            <VerticalStackLayout Padding="20,14" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Style="{StaticResource MzStrong}" Text="{Binding Title}" />
                                                        <Label Style="{StaticResource MzCaption}" Text="{Binding Subtitle}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="1"
                                                        Style="{StaticResource MzStrong}"
                                                        Text="{Binding Total, StringFormat='{0:C2}'}" />
                                                </Grid>
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="6">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:OrderLineViewModel">
                                                            <VerticalStackLayout Spacing="1">
                                                                <Label
                                                                    LineBreakMode="WordWrap"
                                                                    Style="{StaticResource MzBody}"
                                                                    Text="{Binding Text}" />
                                                                <Label
                                                                    IsVisible="{Binding HasDetails}"
                                                                    LineBreakMode="WordWrap"
                                                                    Style="{StaticResource MzCaption}"
                                                                    Text="{Binding Details}" />
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Total e pagamento -->
                            <BoxView Style="{StaticResource MzDivider}" />
                            <VerticalStackLayout
                                x:Name="PayHost"
                                Padding="20"
                                BackgroundColor="{DynamicResource MzSurfaceSunken}"
                                Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Style="{StaticResource MzStrong}" Text="Total a pagar" VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="24"
                                        Text="{Binding Total, StringFormat='{0:C2}'}" />
                                </Grid>
                                <controls:AlertBanner Kind="Info" Text="{Binding BlockedText}" />
                                <Button
                                    Clicked="Pagar_Clicked"
                                    IsEnabled="{Binding CanPay}"
                                    Style="{StaticResource MzPrimaryButton}"
                                    Text="{Binding PayButtonText}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Mesa sem conta aberta -->
            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                MaximumWidthRequest="380"
                Spacing="10"
                VerticalOptions="Center">
                <Border Style="{StaticResource MzEmptyIcon}">
                    <controls:MzIcon
                        Color="{DynamicResource MzTextMuted}"
                        Name="receipt"
                        Size="24" />
                </Border>
                <Label HorizontalOptions="Center" Style="{StaticResource MzSection}" Text="Nenhuma conta aberta" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource MzMuted}"
                    Text="Esta mesa não tem conta para fechar no momento." />
            </VerticalStackLayout>

            <ActivityIndicator
                Margin="0,24,0,0"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>
