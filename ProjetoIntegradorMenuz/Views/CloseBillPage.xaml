<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.CloseBillPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:CloseBillViewModel"
    Title="Fechar conta"
    Shell.NavBarIsVisible="False">

    <!-- A tela tem o próprio botão de voltar; esconde a seta extra que o Windows mostra na barra de título -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- Barra superior -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Style="{StaticResource MzAppBar}">
            <Button
                Command="{Binding GoBackCommand}"
                Style="{StaticResource MzQtyButton}"
                Text="←"
                VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Style="{StaticResource MzTitle}" Text="Fechar conta" />
                <Label Style="{StaticResource MzMuted}" Text="{Binding HeaderText}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <!-- Avisos: falha de conexão e mudança no total -->
        <VerticalStackLayout Grid.Row="2" Margin="20,0" Spacing="8">
            <Border
                Margin="0,14,0,0"
                Padding="14,10"
                BackgroundColor="{StaticResource MzDestructiveTint}"
                IsVisible="{Binding HasError}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Style="{StaticResource MzError}" Text="{Binding ErrorMessage}" />
            </Border>
            <Border
                Margin="0,14,0,0"
                Padding="14,10"
                BackgroundColor="{StaticResource MzWarningTint}"
                IsVisible="{Binding HasNotice}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    Text="{Binding NoticeText}"
                    TextColor="{StaticResource MzWarningText}" />
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <!-- Resumo do que foi pedido -->
            <ScrollView IsVisible="{Binding HasBill}">
                <VerticalStackLayout
                    x:Name="ReceiptHost"
                    Padding="0,16,0,16"
                    BindableLayout.ItemsSource="{Binding Orders}"
                    HorizontalOptions="Center"
                    Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BillOrderSummaryViewModel">
                            <Border Padding="18,14" Style="{StaticResource MzCard}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Style="{StaticResource MzName}" Text="{Binding Title}" />
                                            <Label Style="{StaticResource MzMuted}" Text="{Binding Subtitle}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource MzPrice}"
                                            Text="{Binding Total, StringFormat='{0:C2}'}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView Style="{StaticResource MzDivider}" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OrderLineViewModel">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="15"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding Text}" />
                                                    <Label
                                                        IsVisible="{Binding HasDetails}"
                                                        LineBreakMode="WordWrap"
                                                        Style="{StaticResource MzMuted}"
                                                        Text="{Binding Details}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Mesa sem conta aberta (ex.: já paga ou encerrada pela gerência) -->
            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Spacing="10"
                VerticalOptions="Center">
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                    HeightRequest="88"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="88">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="44" />
                    </Border.StrokeShape>
                    <Label FontSize="40" HorizontalOptions="Center" Text="🧾" VerticalOptions="Center" />
                </Border>
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource MzSection}"
                    Text="Nenhuma conta aberta" />
                <Label
                    Margin="24,0"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource MzMuted}"
                    Text="Esta mesa não tem conta para fechar no momento." />
            </VerticalStackLayout>

            <ActivityIndicator
                Margin="0,24,0,0"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Start" />
        </Grid>

        <!-- Total e pagamento -->
        <Border
            x:Name="PayHost"
            Grid.Row="4"
            Margin="20,8,20,20"
            Padding="20,16"
            HorizontalOptions="Center"
            IsVisible="{Binding HasBill}"
            Style="{StaticResource MzCardRaised}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Style="{StaticResource MzTitle}" Text="Total a pagar" VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontSize="26"
                        Style="{StaticResource MzPrice}"
                        Text="{Binding Total, StringFormat='{0:C2}'}"
                        VerticalOptions="Center" />
                </Grid>

                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    IsVisible="{Binding HasPendingOrders}"
                    Text="{Binding BlockedText}"
                    TextColor="{StaticResource MzWarningText}" />

                <Button
                    Clicked="Pagar_Clicked"
                    HeightRequest="52"
                    IsEnabled="{Binding CanPay}"
                    Style="{StaticResource MzPrimaryButton}"
                    Text="{Binding PayButtonText}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
