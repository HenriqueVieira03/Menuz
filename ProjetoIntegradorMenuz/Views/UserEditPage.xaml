<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.UserEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:UserEditViewModel"
    Title="{Binding PageTitle}"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Style="{StaticResource MzAppBar}">
            <controls:MzButton Command="{Binding CancelCommand}" Icon="arrow-left" Variant="Outline" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzCaption}" Text="Usuários" />
                <Label Style="{StaticResource MzSection}" Text="{Binding PageTitle}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="32,24" MaximumWidthRequest="880" Spacing="16">

                <!-- Dados de acesso -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Dados de acesso" />
                            <Label Style="{StaticResource MzMuted}" Text="Nome exibido no painel e o usuário usado para entrar." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="Nome de exibição" />
                                <Border Style="{StaticResource MzInput}">
                                    <Entry MaxLength="80" Placeholder="Ex.: Maria Silva" Text="{Binding DisplayName}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="Usuário" />
                                <Border Style="{StaticResource MzInput}">
                                    <Entry
                                        IsEnabled="{Binding IsNew}"
                                        IsSpellCheckEnabled="False"
                                        IsTextPredictionEnabled="False"
                                        Keyboard="Plain"
                                        MaxLength="40"
                                        Placeholder="Ex.: maria.silva"
                                        Text="{Binding Username}" />
                                </Border>
                                <Label
                                    IsVisible="{Binding IsNew}"
                                    Style="{StaticResource MzCaption}"
                                    Text="Letras minúsculas, números, ponto, hífen ou sublinhado. Não pode ser alterado depois." />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Perfil e situação -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Permissões" />
                            <Label Style="{StaticResource MzMuted}" Text="Cozinha vê e avança pedidos. Gerência acessa também cardápio, contas, indicadores e usuários." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="Perfil" />
                                <Border Style="{StaticResource MzInput}">
                                    <Picker
                                        ItemDisplayBinding="{Binding Label, x:DataType=vm:RoleOption}"
                                        ItemsSource="{Binding Roles}"
                                        SelectedItem="{Binding SelectedRole}" />
                                </Border>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Style="{StaticResource MzFieldLabel}" Text="Acesso ativo" />
                                    <Label Style="{StaticResource MzCaption}" Text="Desativado, o usuário perde o acesso na hora." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsActive}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Senha -->
                <Border Padding="24" Style="{StaticResource MzCard}">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="32">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource MzSection}" Text="Senha" />
                            <Label Style="{StaticResource MzMuted}" Text="Mínimo de 6 caracteres." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="{Binding PasswordLabel}" />
                                <Border Style="{StaticResource MzInput}">
                                    <Entry IsPassword="True" Placeholder="{Binding PasswordPlaceholder}" Text="{Binding Password}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MzFieldLabel}" Text="Confirmar senha" />
                                <Border Style="{StaticResource MzInput}">
                                    <Entry
                                        IsPassword="True"
                                        Placeholder="Repita a senha"
                                        ReturnCommand="{Binding SaveCommand}"
                                        ReturnType="Go"
                                        Text="{Binding ConfirmPassword}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rodapé -->
        <BoxView Grid.Row="3" Style="{StaticResource MzDivider}" />
        <Grid
            Grid.Row="4"
            Padding="32,12"
            BackgroundColor="{DynamicResource MzSurface}"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12">
            <controls:AlertBanner Kind="Error" Text="{Binding ErrorMessage}" VerticalOptions="Center" />
            <controls:MzButton Grid.Column="1" Command="{Binding CancelCommand}" Text="Cancelar" Variant="Outline" />
            <controls:MzButton
                Grid.Column="2"
                Command="{Binding SaveCommand}"
                Icon="check"
                IsLoading="{Binding IsBusy}"
                Text="{Binding SaveText}"
                Variant="Primary" />
        </Grid>
    </Grid>
</ContentPage>
