<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.OrderSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pedido confirmado"
    Shell.NavBarIsVisible="False">

    <!-- A tela tem o próprio botão de voltar; esconde a seta extra que o Windows mostra na barra de título -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid Padding="20">
        <Border
            Padding="40,44"
            HorizontalOptions="Center"
            MaximumWidthRequest="480"
            Style="{StaticResource MzCardRaised}"
            VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="18">

                <Border
                    BackgroundColor="{StaticResource MzSuccessTint}"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="96">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="48" />
                    </Border.StrokeShape>
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="44"
                        HorizontalOptions="Center"
                        Text="✓"
                        TextColor="{StaticResource MzSuccessText}"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzDisplay}"
                        Text="Pedido enviado!" />
                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzBody}"
                        Text="A cozinha já recebeu seu pedido e logo ele chega à sua mesa."
                        TextColor="{AppThemeBinding Light={StaticResource MzMutedForegroundLight}, Dark={StaticResource MzMutedForegroundDark}}" />
                </VerticalStackLayout>

                <Border
                    Margin="0,6"
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label FontSize="18" Text="⏱️" VerticalOptions="Center" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            Text="Tempo estimado: 20 a 30 minutos"
                            TextColor="{StaticResource MzPrimaryDeep}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Button
                    x:Name="VoltarMenu"
                    Clicked="VoltarMenu_Clicked"
                    HeightRequest="52"
                    Style="{StaticResource MzPrimaryButton}"
                    Text="Voltar ao cardápio" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
