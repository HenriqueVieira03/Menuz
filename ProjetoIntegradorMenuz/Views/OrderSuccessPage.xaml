<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.OrderSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    Title="Pedido enviado"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid Padding="24">
        <Border
            Padding="40"
            HorizontalOptions="Center"
            MaximumWidthRequest="460"
            Style="{StaticResource MzCard}"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="20">
                <Border
                    BackgroundColor="{DynamicResource MzSuccessSoft}"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="64">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <controls:MzIcon
                        Color="{DynamicResource MzSuccessText}"
                        Name="check"
                        Size="30" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzTitle}"
                        Text="Pedido enviado" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzMuted}"
                        Text="A cozinha já recebeu o seu pedido. Você pode acompanhar o preparo em Meus pedidos." />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Button
                        x:Name="Acompanhar"
                        Clicked="Acompanhar_Clicked"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="Acompanhar pedido" />
                    <Button
                        x:Name="VoltarMenu"
                        Clicked="VoltarMenu_Clicked"
                        Style="{StaticResource MzOutlineButton}"
                        Text="Voltar ao cardápio" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
