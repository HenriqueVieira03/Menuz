<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.MenuPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:MenuViewModel"
    Title="Cardápio"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
            <Grid
                Grid.Row="0"
                Padding="24,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}"
                ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                ColumnSpacing="12">
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}"
                    HeightRequest="40"
                    Stroke="Transparent"
                    WidthRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="M"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="22"
                        Text="Menuz"
                        TextColor="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                    <Label Style="{StaticResource MzMuted}" Text="Peça direto da sua mesa" />
                </VerticalStackLayout>

                <!-- Mesa deste tablet (toque para configurar) -->
                <Border
                    Grid.Column="2"
                    Padding="14,8"
                    Style="{StaticResource MzChip}"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTableCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding Table.IsConfigured}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label
                        FontFamily="OpenSansSemibold"
                        Style="{StaticResource MzChipLabel}"
                        Text="{Binding Table.DisplayText, StringFormat='🪑 {0}'}" />
                </Border>

                <!-- Acesso da equipe (cozinha/gerência), com login -->
                <Button
                    Grid.Column="3"
                    Command="{Binding OpenStaffCommand}"
                    Style="{StaticResource MzGhostButton}"
                    Text="🔒 Equipe"
                    VerticalOptions="Center" />

                <!-- Botão de Carrinho com Ícone Vetorial (Caminho SVG) -->
                <Grid Grid.Column="4"
                      VerticalOptions="Center"
                      Padding="8"
                      BackgroundColor="Transparent">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                    </Grid.GestureRecognizers>

                    <Path Fill="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}"
                          Data="M15.55 13c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.37-.66-.11-1.48-.87-1.48H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.44C4.52 15.37 5.48 17 7 17h12v-2H7l1.1-2h7.45zM6.16 6h12.15l-2.76 5H8.53L6.16 6zM7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                          HeightRequest="25"
                          WidthRequest="25"
                          Aspect="Uniform" />
                </Grid>
            </Grid>

            <ScrollView
                Grid.Row="1"
                HorizontalScrollBarVisibility="Never"
                Orientation="Horizontal">
                <HorizontalStackLayout
                    Padding="20,14"
                    BindableLayout.ItemsSource="{Binding Chips}"
                    Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChipViewModel">
                            <Border Padding="18,10" Style="{StaticResource MzChip}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <HorizontalStackLayout Spacing="8">
                                    <Label
                                        FontSize="20"
                                        Text="{Binding Icon}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Style="{StaticResource MzChipLabel}"
                                        Text="{Binding Name}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2">
                <CollectionView
                    x:Name="ProductsList"
                    Margin="20,0"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding Products}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="ProductsLayout"
                            HorizontalItemSpacing="16"
                            Orientation="Vertical"
                            Span="3"
                            VerticalItemSpacing="16" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Padding="0,0,0,16" Spacing="16">
                            <Border Padding="24" Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#F77F00" />
                                        <GradientStop Offset="1" Color="#CC6600" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="24"
                                        Text="Seu pedido, do seu jeito"
                                        TextColor="White" />
                                    <Label
                                        FontSize="14"
                                        Text="Escolha os itens, adicione ao carrinho e envie para a cozinha."
                                        TextColor="#FFF4E6" />
                                </VerticalStackLayout>
                            </Border>
                            <Label Style="{StaticResource MzTitle}" Text="{Binding SectionTitle}" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="110" Color="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProductItemViewModel">
                            <Border
                                Padding="0"
                                BindingContextChanged="OnCardBindingContextChanged"
                                Style="{StaticResource MzCard}">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenProductCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="150,Auto,44,Auto" RowSpacing="4">
                                    <BoxView
                                        Grid.Row="0"
                                        Color="{AppThemeBinding Light={StaticResource MzMutedLight}, Dark={StaticResource MzMutedDark}}" />
                                    <Label
                                        Grid.Row="0"
                                        FontSize="40"
                                        HorizontalOptions="Center"
                                        Text="🍽️"
                                        VerticalOptions="Center" />
                                    <Image
                                        Grid.Row="0"
                                        Aspect="AspectFill"
                                        Source="{Binding Picture}" />

                                    <Label
                                        Grid.Row="1"
                                        Margin="14,10,14,0"
                                        Style="{StaticResource MzName}"
                                        Text="{Binding Name}" />
                                    <Label
                                        Grid.Row="2"
                                        Margin="14,0"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Style="{StaticResource MzMuted}"
                                        Text="{Binding Description}" />
                                    <Grid
                                        Grid.Row="3"
                                        Margin="14,4,14,14"
                                        ColumnDefinitions="*,Auto">
                                        <Label
                                            Style="{StaticResource MzPrice}"
                                            Text="{Binding PriceText}"
                                            VerticalOptions="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddToCartCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="40"
                                            Style="{StaticResource MzPrimaryButton}"
                                            Text="{Binding ButtonText}">
                                            <Button.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsAdded}"
                                                    TargetType="Button"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource MzSuccess}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    Color="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasError}"
                    Spacing="14"
                    VerticalOptions="Center">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzMuted}"
                        Text="{Binding ErrorMessage}" />
                    <Button
                        Command="{Binding LoadCommand}"
                        HorizontalOptions="Center"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="Tentar novamente" />
                </VerticalStackLayout>

                <Border
                    x:Name="CartBar"
                    MaximumWidthRequest="680"
                    Margin="20,0,20,20"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    Stroke="Transparent"
                    VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="#532718"
                            Opacity="0.25"
                            Radius="16"
                            Offset="0,6" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                    </Border.GestureRecognizers>
                    <Grid Padding="22,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label
                                FontSize="13"
                                Text="{Binding Cart.TotalCount, StringFormat='{0} no carrinho'}"
                                TextColor="#FFF4E6" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                Text="{Binding Cart.TotalPrice, StringFormat='{0:C2}'}"
                                TextColor="White" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            FontFamily="OpenSansSemibold"
                            FontSize="16"
                            Text="Ver carrinho  →"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Popup de detalhes e personalização do produto -->
        <Grid x:Name="PopupProduto" IsVisible="{Binding IsCustomizing}">
            <!-- Fundo escurecido: tocar fora fecha -->
            <BoxView Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseProductCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="PopupCard"
                Margin="20"
                Padding="0"
                x:DataType="vm:ProductCustomizationViewModel"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource MzCardDark}}"
                BindingContext="{Binding Customization}"
                HorizontalOptions="Center"
                MaximumWidthRequest="520"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <Grid RowDefinitions="*,Auto">

                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout>
                            <Grid HeightRequest="220">
                                <BoxView Color="{AppThemeBinding Light={StaticResource MzMutedLight}, Dark={StaticResource MzMutedDark}}" />
                                <Label
                                    FontSize="48"
                                    HorizontalOptions="Center"
                                    Text="🍽️"
                                    VerticalOptions="Center" />
                                <Image Aspect="AspectFill" Source="{Binding Picture}" />
                                <Button
                                    Margin="10"
                                    Padding="0"
                                    BackgroundColor="#80000000"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CloseProductCommand}"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    Text="✕"
                                    TextColor="White"
                                    VerticalOptions="Start"
                                    WidthRequest="40" />
                            </Grid>

                            <VerticalStackLayout Padding="24,20" Spacing="18">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        FontSize="24"
                                        Style="{StaticResource MzTitle}"
                                        Text="{Binding Name}" />
                                    <Label
                                        LineBreakMode="WordWrap"
                                        Style="{StaticResource MzMuted}"
                                        Text="{Binding Description}" />
                                </VerticalStackLayout>

                                <!-- Tamanho: escolha única -->
                                <VerticalStackLayout IsVisible="{Binding HasSizes}" Spacing="10">
                                    <Label Style="{StaticResource MzName}" Text="Tamanho" />
                                    <FlexLayout
                                        AlignItems="Start"
                                        BindableLayout.ItemsSource="{Binding Sizes}"
                                        Direction="Row"
                                        Wrap="Wrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionViewModel">
                                                <Border
                                                    Margin="0,0,10,10"
                                                    Padding="16,10"
                                                    Style="{StaticResource MzChip}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PopupCard}, Path=BindingContext.SelectSizeCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsSelected}"
                                                            TargetType="Border"
                                                            Value="True">
                                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <VerticalStackLayout HorizontalOptions="Center">
                                                        <Label
                                                            HorizontalTextAlignment="Center"
                                                            Style="{StaticResource MzChipLabel}"
                                                            Text="{Binding Name}" />
                                                        <Label
                                                            FontSize="12"
                                                            HorizontalTextAlignment="Center"
                                                            IsVisible="{Binding HasPrice}"
                                                            Style="{StaticResource MzMuted}"
                                                            Text="{Binding PriceText}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                                <!-- Adicionais: vários -->
                                <VerticalStackLayout IsVisible="{Binding HasAddons}" Spacing="4">
                                    <Label Style="{StaticResource MzName}" Text="Adicionais" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Addons}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PopupCard}, Path=BindingContext.ToggleCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <CheckBox
                                                        InputTransparent="True"
                                                        IsChecked="{Binding IsSelected}"
                                                        Color="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="2"
                                                        Style="{StaticResource MzMuted}"
                                                        Text="{Binding PriceText}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Ingredientes: desmarcar = pedir sem -->
                                <VerticalStackLayout IsVisible="{Binding HasIngredients}" Spacing="4">
                                    <Label Style="{StaticResource MzName}" Text="Ingredientes" />
                                    <Label
                                        FontSize="13"
                                        Style="{StaticResource MzMuted}"
                                        Text="Desmarque o que você quer retirar." />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionViewModel">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PopupCard}, Path=BindingContext.ToggleCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <CheckBox
                                                        InputTransparent="True"
                                                        IsChecked="{Binding IsSelected}"
                                                        Color="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Observação -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource MzName}" Text="Observação" />
                                    <Border Padding="10,2" Style="{StaticResource MzCard}">
                                        <Editor
                                            AutoSize="TextChanges"
                                            MaxLength="{Binding NotesMaxLength}"
                                            MinimumHeightRequest="44"
                                            Placeholder="Ex.: carne bem passada"
                                            Text="{Binding Notes, Mode=TwoWay}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Rodapé fixo: quantidade e adicionar -->
                    <Grid
                        Grid.Row="1"
                        Padding="24,14,24,20"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Button
                                Command="{Binding DecreaseCommand}"
                                Style="{StaticResource MzQtyButton}"
                                Text="−" />
                            <Label
                                HorizontalTextAlignment="Center"
                                MinimumWidthRequest="28"
                                Style="{StaticResource MzName}"
                                Text="{Binding Quantity}"
                                VerticalOptions="Center" />
                            <Button
                                Command="{Binding IncreaseCommand}"
                                Style="{StaticResource MzQtyButton}"
                                Text="+" />
                        </HorizontalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ConfirmProductCommand}"
                            HeightRequest="50"
                            Style="{StaticResource MzPrimaryButton}"
                            Text="{Binding AddButtonText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>