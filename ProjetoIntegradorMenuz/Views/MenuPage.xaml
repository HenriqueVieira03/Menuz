<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.MenuPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:models="clr-namespace:ProjetoIntegradorMenuz.Models"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:MenuViewModel"
    Title="Cardápio"
    Shell.NavBarIsVisible="False">

    <!--
        Layout responsivo (MenuPage.xaml.cs):
        - largo  (tablet na horizontal): categorias à esquerda · produtos · pedido à direita
        - médio: categorias à esquerda · produtos · barra do pedido embaixo
        - estreito (celular): categorias em abas no topo · produtos · barra do pedido embaixo
    -->
    <Grid>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- ================= Barra superior ================= -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Style="{StaticResource MzAppBar}">
                <Border Style="{StaticResource MzLogo}">
                    <Label Style="{StaticResource MzLogoLabel}" Text="{Binding Theme.Initial}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Style="{StaticResource MzName}" Text="{Binding Theme.RestaurantName}" />
                    <HorizontalStackLayout Spacing="4">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTableCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <controls:MzIcon
                            Color="{DynamicResource MzTextMuted}"
                            Name="hash"
                            Size="13" />
                        <Label Style="{StaticResource MzCaption}" Text="{Binding Table.DisplayText}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <controls:MzButton
                    Grid.Column="2"
                    Command="{Binding OpenMyOrdersCommand}"
                    Icon="receipt"
                    Text="Meus pedidos"
                    Variant="Ghost" />
                <controls:MzButton
                    Grid.Column="3"
                    Command="{Binding OpenStaffCommand}"
                    Icon="lock"
                    Text="Equipe"
                    Variant="Ghost" />

                <!-- Sacola (telas sem o painel do pedido) -->
                <Grid
                    x:Name="HeaderCart"
                    Grid.Column="4"
                    HeightRequest="44"
                    VerticalOptions="Center"
                    WidthRequest="48">
                    <controls:MzButton
                        Command="{Binding OpenCartCommand}"
                        HorizontalOptions="Start"
                        Icon="bag"
                        Variant="Subtle"
                        VerticalOptions="End" />
                    <Border
                        Padding="5,0"
                        BackgroundColor="{DynamicResource MzPrimary}"
                        HeightRequest="18"
                        HorizontalOptions="End"
                        InputTransparent="True"
                        IsVisible="{Binding Cart.HasItems}"
                        MinimumWidthRequest="18"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="{Binding Cart.TotalCount}"
                            TextColor="{DynamicResource MzOnPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>
            <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

            <Grid x:Name="Body" Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

                <!-- ================= Categorias (lista lateral) ================= -->
                <Grid
                    x:Name="CategoryRail"
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource MzSurface}"
                    ColumnDefinitions="*,Auto"
                    WidthRequest="232">
                    <ScrollView>
                        <VerticalStackLayout Padding="12,20" Spacing="2">
                            <Label
                                Margin="12,0,0,10"
                                Style="{StaticResource MzColumnHeader}"
                                Text="Categorias" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Chips}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryChipViewModel">
                                        <Border
                                            Padding="12,10"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource MzPrimarySoft}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="14"
                                                    Text="{Binding Name}"
                                                    TextColor="{DynamicResource MzTextMuted}"
                                                    VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource MzPrimaryStrong}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label
                                                    Grid.Column="1"
                                                    Style="{StaticResource MzCaption}"
                                                    Text="{Binding Count}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                    <BoxView Grid.Column="1" Style="{StaticResource MzVDivider}" />
                </Grid>

                <!-- ================= Produtos ================= -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*">

                    <!-- Categorias em abas (celular) -->
                    <ScrollView
                        x:Name="CategoryTabs"
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="False"
                        Orientation="Horizontal">
                        <HorizontalStackLayout
                            Padding="16,12"
                            BindableLayout.ItemsSource="{Binding Chips}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryChipViewModel">
                                    <Border Style="{StaticResource MzChip}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource MzText}" />
                                                <Setter Property="Stroke" Value="{DynamicResource MzText}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Style="{StaticResource MzChipLabel}" Text="{Binding Name}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource MzSurface}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <CollectionView
                        x:Name="ProductsList"
                        Grid.Row="1"
                        Margin="24,0"
                        ItemSizingStrategy="MeasureFirstItem"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="ProductsLayout"
                                HorizontalItemSpacing="16"
                                Orientation="Vertical"
                                Span="3"
                                VerticalItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.Header>
                            <Grid Padding="0,24,0,16" ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource MzPageTitle}" Text="{Binding SectionTitle}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource MzMuted}"
                                    Text="{Binding SectionCount}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.Footer>
                            <BoxView x:Name="ListFooter" HeightRequest="104" Color="Transparent" />
                        </CollectionView.Footer>

                        <!-- Cartão do produto -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductItemViewModel">
                                <Border
                                    Padding="0"
                                    BindingContextChanged="OnCardBindingContextChanged"
                                    Style="{StaticResource MzCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenProductCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="160,Auto,40,Auto">
                                        <BoxView Color="{DynamicResource MzSurfaceAlt}" />
                                        <controls:MzIcon
                                            Color="{DynamicResource MzTextSubtle}"
                                            Name="image"
                                            Size="28" />
                                        <Image Aspect="AspectFill" Source="{Binding Picture}" />

                                        <Label
                                            Grid.Row="1"
                                            Margin="16,14,16,4"
                                            Style="{StaticResource MzName}"
                                            Text="{Binding Name}" />
                                        <Label
                                            Grid.Row="2"
                                            Margin="16,0"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource MzMuted}"
                                            Text="{Binding Description}" />
                                        <Grid
                                            Grid.Row="3"
                                            Margin="16,8,12,12"
                                            ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                <Label
                                                    IsVisible="{Binding HasPriceFrom}"
                                                    Style="{StaticResource MzCaption}"
                                                    Text="a partir de" />
                                                <Label Style="{StaticResource MzPrice}" Text="{Binding PriceText}" />
                                            </VerticalStackLayout>
                                            <controls:MzButton
                                                Grid.Column="1"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddToCartCommand}"
                                                CommandParameter="{Binding .}"
                                                Icon="{Binding AddIcon}"
                                                Variant="Primary" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator
                        Grid.Row="1"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center" />

                    <!-- Erro ao carregar -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        MaximumWidthRequest="380"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Border Style="{StaticResource MzEmptyIcon}">
                            <controls:MzIcon
                                Color="{DynamicResource MzTextMuted}"
                                Name="wifi-off"
                                Size="26" />
                        </Border>
                        <Label HorizontalOptions="Center" Style="{StaticResource MzSection}" Text="Cardápio indisponível" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource MzMuted}"
                            Text="{Binding ErrorMessage}" />
                        <controls:MzButton
                            Command="{Binding LoadCommand}"
                            HorizontalOptions="Center"
                            Icon="refresh"
                            Text="Tentar novamente"
                            Variant="Primary" />
                    </VerticalStackLayout>

                    <!-- Barra do pedido (telas sem o painel lateral) -->
                    <Border
                        x:Name="CartBar"
                        Grid.Row="1"
                        Margin="24,0,24,20"
                        Padding="0"
                        BackgroundColor="{DynamicResource MzText}"
                        HorizontalOptions="Fill"
                        IsVisible="False"
                        MaximumWidthRequest="640"
                        Shadow="{StaticResource MzShadow}"
                        StrokeThickness="0"
                        VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                        </Border.GestureRecognizers>
                        <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                BackgroundColor="{DynamicResource MzPrimary}"
                                HeightRequest="32"
                                StrokeThickness="0"
                                WidthRequest="32">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    HorizontalOptions="Center"
                                    Text="{Binding Cart.TotalCount}"
                                    TextColor="{DynamicResource MzOnPrimary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="Ver pedido"
                                TextColor="{DynamicResource MzSurface}"
                                VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"
                                    Text="{Binding Cart.TotalPrice, StringFormat='{0:C2}'}"
                                    TextColor="{DynamicResource MzSurface}"
                                    VerticalOptions="Center" />
                                <controls:MzIcon
                                    Color="{DynamicResource MzSurface}"
                                    Name="chevron-right"
                                    Size="18" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= Pedido (painel lateral) ================= -->
                <Grid
                    x:Name="OrderPanel"
                    Grid.Column="2"
                    BackgroundColor="{DynamicResource MzSurface}"
                    ColumnDefinitions="Auto,*"
                    WidthRequest="340">
                    <BoxView Style="{StaticResource MzVDivider}" />
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Padding="20,20,20,12" Spacing="2">
                            <Label Style="{StaticResource MzSection}" Text="Seu pedido" />
                            <Label Style="{StaticResource MzCaption}" Text="{Binding Table.DisplayText}" />
                        </VerticalStackLayout>

                        <!-- Itens -->
                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding Cart.Items}"
                            SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    Padding="24"
                                    Spacing="10"
                                    VerticalOptions="Center">
                                    <Border Style="{StaticResource MzEmptyIcon}">
                                        <controls:MzIcon
                                            Color="{DynamicResource MzTextMuted}"
                                            Name="bag"
                                            Size="24" />
                                    </Border>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource MzStrong}"
                                        Text="Nenhum item ainda" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource MzMuted}"
                                        Text="Toque em um produto para ver as opções e adicionar." />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CartItem">
                                    <Grid Padding="20,12" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    LineBreakMode="WordWrap"
                                                    Style="{StaticResource MzStrong}"
                                                    Text="{Binding DisplayName}" />
                                                <Label
                                                    IsVisible="{Binding HasOptions}"
                                                    LineBreakMode="WordWrap"
                                                    Style="{StaticResource MzCaption}"
                                                    Text="{Binding OptionsText}" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="1"
                                                Style="{StaticResource MzStrong}"
                                                Text="{Binding Subtotal, StringFormat='{0:C2}'}" />
                                        </Grid>
                                        <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                            <controls:MzButton
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DecreaseItemCommand}"
                                                CommandParameter="{Binding .}"
                                                Icon="minus"
                                                Size="30"
                                                Variant="Outline" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                HorizontalTextAlignment="Center"
                                                MinimumWidthRequest="20"
                                                Text="{Binding Quantity}"
                                                VerticalOptions="Center" />
                                            <controls:MzButton
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IncreaseItemCommand}"
                                                CommandParameter="{Binding .}"
                                                Icon="plus"
                                                Size="30"
                                                Variant="Outline" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Total -->
                        <VerticalStackLayout Grid.Row="2" Padding="20,0,20,20" Spacing="14">
                            <BoxView Style="{StaticResource MzDivider}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource MzMuted}" Text="Total" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="20"
                                    Text="{Binding Cart.TotalPrice, StringFormat='{0:C2}'}" />
                            </Grid>
                            <controls:MzButton
                                Command="{Binding OpenCartCommand}"
                                HorizontalOptions="Fill"
                                Icon="arrow-right"
                                Size="48"
                                Text="Revisar e enviar"
                                Variant="Primary" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= Detalhes e personalização do produto ================= -->
        <Grid x:Name="PopupProduto" IsVisible="{Binding IsCustomizing}">
            <BoxView Color="{StaticResource MzScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseProductCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="PopupCard"
                Margin="20"
                Padding="0"
                x:DataType="vm:ProductCustomizationViewModel"
                BindingContext="{Binding Customization}"
                HorizontalOptions="Center"
                MaximumWidthRequest="560"
                Style="{StaticResource MzDialog}"
                VerticalOptions="Center">
                <Grid RowDefinitions="*,Auto,Auto">

                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout>
                            <Grid HeightRequest="220">
                                <BoxView Color="{DynamicResource MzSurfaceAlt}" />
                                <controls:MzIcon
                                    Color="{DynamicResource MzTextSubtle}"
                                    Name="image"
                                    Size="36" />
                                <Image Aspect="AspectFill" Source="{Binding Picture}" />
                                <controls:MzButton
                                    Margin="12"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CloseProductCommand}"
                                    HorizontalOptions="End"
                                    Icon="x"
                                    Size="36"
                                    Variant="Outline"
                                    VerticalOptions="Start" />
                            </Grid>

                            <VerticalStackLayout Padding="24,20" Spacing="24">
                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource MzTitle}" Text="{Binding Name}" />
                                    <Label
                                        LineBreakMode="WordWrap"
                                        Style="{StaticResource MzBody}"
                                        Text="{Binding Description}"
                                        TextColor="{DynamicResource MzTextMuted}" />
                                </VerticalStackLayout>

                                <!-- Tamanho -->
                                <VerticalStackLayout IsVisible="{Binding HasSizes}" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource MzStrong}" Text="Tamanho" />
                                        <Label Grid.Column="1" Style="{StaticResource MzCaption}" Text="Obrigatório" />
                                    </Grid>
                                    <FlexLayout
                                        AlignItems="Start"
                                        BindableLayout.ItemsSource="{Binding Sizes}"
                                        Direction="Row"
                                        Wrap="Wrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionViewModel">
                                                <Border
                                                    Margin="0,0,8,8"
                                                    Padding="16,9"
                                                    Style="{StaticResource MzChip}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PopupCard}, Path=BindingContext.SelectSizeCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource MzPrimary}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource MzPrimarySoft}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <VerticalStackLayout>
                                                        <Label Style="{StaticResource MzStrong}" Text="{Binding Name}" />
                                                        <Label
                                                            IsVisible="{Binding HasPrice}"
                                                            Style="{StaticResource MzCaption}"
                                                            Text="{Binding PriceText}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                                <!-- Adicionais -->
                                <VerticalStackLayout IsVisible="{Binding HasAddons}" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource MzStrong}" Text="Adicionais" />
                                        <Label Grid.Column="1" Style="{StaticResource MzCaption}" Text="Opcional" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Addons}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" MinimumHeightRequest="44">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PopupCard}, Path=BindingContext.ToggleCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <CheckBox
                                                        InputTransparent="True"
                                                        IsChecked="{Binding IsSelected}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Style="{StaticResource MzBody}"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="2"
                                                        Style="{StaticResource MzMuted}"
                                                        Text="{Binding PriceText}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Ingredientes -->
                                <VerticalStackLayout IsVisible="{Binding HasIngredients}" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource MzStrong}" Text="Ingredientes" />
                                        <Label Grid.Column="1" Style="{StaticResource MzCaption}" Text="Desmarque para retirar" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionViewModel">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" MinimumHeightRequest="44">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PopupCard}, Path=BindingContext.ToggleCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <CheckBox
                                                        InputTransparent="True"
                                                        IsChecked="{Binding IsSelected}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        Style="{StaticResource MzBody}"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Observação -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource MzStrong}" Text="Observação" />
                                    <Border Padding="8,4" Style="{StaticResource MzInput}">
                                        <Editor
                                            AutoSize="TextChanges"
                                            MaxLength="{Binding NotesMaxLength}"
                                            MinimumHeightRequest="44"
                                            Placeholder="Ex.: carne bem passada, molho à parte"
                                            Text="{Binding Notes, Mode=TwoWay}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

                    <Grid
                        Grid.Row="2"
                        Padding="20,14"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <controls:MzButton Command="{Binding DecreaseCommand}" Icon="minus" Variant="Outline" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                MinimumWidthRequest="24"
                                Text="{Binding Quantity}"
                                VerticalOptions="Center" />
                            <controls:MzButton Command="{Binding IncreaseCommand}" Icon="plus" Variant="Outline" />
                        </HorizontalStackLayout>
                        <controls:MzButton
                            Grid.Column="1"
                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ConfirmProductCommand}"
                            HorizontalOptions="Fill"
                            Size="48"
                            Text="{Binding AddButtonText}"
                            Variant="Primary" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
