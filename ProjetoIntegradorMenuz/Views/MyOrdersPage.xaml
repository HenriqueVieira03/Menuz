<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.MyOrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:MyOrdersViewModel"
    Title="Meus pedidos"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Style="{StaticResource MzAppBar}">
            <controls:MzButton Command="{Binding GoBackCommand}" Icon="arrow-left" Variant="Outline" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzSection}" Text="Meus pedidos" />
                <Label Style="{StaticResource MzCaption}" Text="{Binding HeaderText}" />
            </VerticalStackLayout>
            <controls:MzButton
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                Icon="refresh"
                Text="Atualizar"
                Variant="Outline" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <controls:AlertBanner
            Grid.Row="2"
            Margin="24,16,24,0"
            Kind="Error"
            Text="{Binding ErrorMessage}" />

        <Grid Grid.Row="3">
            <CollectionView
                x:Name="OrdersList"
                Margin="24,16,24,0"
                IsVisible="{Binding HasOrders}"
                ItemSizingStrategy="MeasureAllItems"
                ItemsSource="{Binding Orders}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        x:Name="OrdersLayout"
                        HorizontalItemSpacing="16"
                        Orientation="Vertical"
                        Span="2"
                        VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientOrderViewModel">
                        <Border Padding="20,16" Style="{StaticResource MzCard}">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsCancelled}" TargetType="Border" Value="True">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Style="{StaticResource MzName}" Text="{Binding Title}" />
                                        <Label Style="{StaticResource MzCaption}" Text="{Binding Subtitle}" />
                                    </VerticalStackLayout>
                                    <controls:StatusBadge
                                        Grid.Column="1"
                                        Status="{Binding Status}"
                                        Text="{Binding StatusText}"
                                        VerticalOptions="Start" />
                                </Grid>

                                <Label Style="{StaticResource MzMuted}" Text="{Binding StatusHint}" />

                                <BoxView Style="{StaticResource MzDivider}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OrderLineViewModel">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    LineBreakMode="WordWrap"
                                                    Style="{StaticResource MzStrong}"
                                                    Text="{Binding Text}" />
                                                <Label
                                                    IsVisible="{Binding HasDetails}"
                                                    LineBreakMode="WordWrap"
                                                    Style="{StaticResource MzCaption}"
                                                    Text="{Binding Details}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView Style="{StaticResource MzDivider}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Style="{StaticResource MzMuted}" Text="Total do pedido" VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource MzPrice}"
                                        Text="{Binding Total, StringFormat='{0:C2}'}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Conta ainda sem pedidos (ou mesa não definida) -->
            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                MaximumWidthRequest="380"
                Spacing="10"
                VerticalOptions="Center">
                <Border Style="{StaticResource MzEmptyIcon}">
                    <controls:MzIcon
                        Color="{DynamicResource MzTextMuted}"
                        Name="receipt"
                        Size="24" />
                </Border>
                <Label HorizontalOptions="Center" Style="{StaticResource MzSection}" Text="Nenhum pedido ainda" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource MzMuted}"
                    Text="{Binding EmptyText}" />
            </VerticalStackLayout>

            <ActivityIndicator
                Margin="0,24,0,0"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Start" />
        </Grid>

        <!-- Total da conta -->
        <Grid Grid.Row="4" IsVisible="{Binding HasOrders}" RowDefinitions="Auto,Auto">
            <BoxView Style="{StaticResource MzDivider}" />
            <Grid
                Grid.Row="1"
                Padding="24,14"
                BackgroundColor="{DynamicResource MzSurface}"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="24">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Style="{StaticResource MzStrong}" Text="Total da conta" />
                    <Label Style="{StaticResource MzCaption}" Text="{Binding OrdersCountText}" />
                </VerticalStackLayout>
                <Label
                    Grid.Column="1"
                    FontFamily="OpenSansSemibold"
                    FontSize="22"
                    Text="{Binding Total, StringFormat='{0:C2}'}"
                    VerticalOptions="Center" />
                <controls:MzButton
                    Grid.Column="2"
                    Command="{Binding CloseBillCommand}"
                    Icon="card"
                    Size="48"
                    Text="Fechar conta"
                    Variant="Primary" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
