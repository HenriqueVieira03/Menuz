<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    xmlns:models="clr-namespace:ProjetoIntegradorMenuz.Models"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:CartViewModel"
    Title="Revisar pedido"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Style="{StaticResource MzAppBar}">
            <controls:MzButton Command="{Binding GoBackCommand}" Icon="arrow-left" Variant="Outline" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzSection}" Text="Revisar pedido" />
                <Label Style="{StaticResource MzCaption}" Text="{Binding Table.DisplayText}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <Grid
            x:Name="ContentGrid"
            Grid.Row="2"
            Padding="24"
            ColumnDefinitions="*,360"
            ColumnSpacing="24"
            HorizontalOptions="Center"
            MaximumWidthRequest="1120"
            RowDefinitions="*"
            RowSpacing="16">

            <!-- Itens -->
            <Border Padding="0" Style="{StaticResource MzCard}" VerticalOptions="Start">
                <CollectionView ItemsSource="{Binding Cart.Items}" SelectionMode="None">
                    <CollectionView.Header>
                        <Grid Padding="20,16" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource MzColumnHeader}" Text="Item" />
                            <Label Grid.Column="1" Style="{StaticResource MzColumnHeader}" Text="Subtotal" />
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24,48" Spacing="10">
                            <Border Style="{StaticResource MzEmptyIcon}">
                                <controls:MzIcon
                                    Color="{DynamicResource MzTextMuted}"
                                    Name="bag"
                                    Size="24" />
                            </Border>
                            <Label HorizontalOptions="Center" Style="{StaticResource MzSection}" Text="Seu pedido está vazio" />
                            <Label HorizontalOptions="Center" Style="{StaticResource MzMuted}" Text="Volte ao cardápio e escolha os itens." />
                            <controls:MzButton
                                Margin="0,8,0,0"
                                Command="{Binding GoBackCommand}"
                                HorizontalOptions="Center"
                                Icon="book"
                                Text="Ver cardápio"
                                Variant="Primary" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItem">
                            <VerticalStackLayout>
                                <BoxView Style="{StaticResource MzDivider}" />
                                <Grid
                                    Padding="20,16"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="16"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Style="{StaticResource MzName}" Text="{Binding DisplayName}" />
                                        <Label
                                            IsVisible="{Binding HasOptions}"
                                            LineBreakMode="WordWrap"
                                            Style="{StaticResource MzMuted}"
                                            Text="{Binding OptionsText}" />
                                        <Label Style="{StaticResource MzCaption}" Text="{Binding UnitPrice, StringFormat='{0:C2} cada'}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource MzPrice}"
                                        Text="{Binding Subtotal, StringFormat='{0:C2}'}"
                                        HorizontalOptions="End" />

                                    <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                        <controls:MzButton
                                            Command="{Binding BindingContext.DecreaseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            Icon="minus"
                                            Size="34"
                                            Variant="Outline" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="15"
                                            HorizontalTextAlignment="Center"
                                            MinimumWidthRequest="24"
                                            Text="{Binding Quantity}"
                                            VerticalOptions="Center" />
                                        <controls:MzButton
                                            Command="{Binding BindingContext.IncreaseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            Icon="plus"
                                            Size="34"
                                            Variant="Outline" />
                                    </HorizontalStackLayout>
                                    <controls:MzButton
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Command="{Binding BindingContext.RemoveCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="End"
                                        Icon="trash"
                                        Size="34"
                                        Text="Remover"
                                        Variant="Ghost" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Resumo -->
            <Border
                x:Name="SummaryCard"
                Grid.Column="1"
                Padding="20"
                Style="{StaticResource MzCard}"
                VerticalOptions="Start">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource MzSection}" Text="Resumo" />

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource MzMuted}" Text="Itens" />
                            <Label Grid.Column="1" Style="{StaticResource MzBody}" Text="{Binding Cart.TotalCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource MzMuted}" Text="Mesa" />
                            <Label Grid.Column="1" Style="{StaticResource MzBody}" Text="{Binding Table.TableNumber, TargetNullValue='—'}" />
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource MzDivider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource MzStrong}" Text="Total" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            Text="{Binding Cart.TotalPrice, StringFormat='{0:C2}'}" />
                    </Grid>

                    <Button
                        x:Name="FinalizarPedido"
                        Clicked="FinalizarPedido_Clicked"
                        IsEnabled="{Binding IsNotSubmitting}"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="Enviar para a cozinha" />

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzCaption}"
                        Text="{Binding Table.CartHint}" />

                    <controls:MzButton
                        Command="{Binding ClearCommand}"
                        HorizontalOptions="Center"
                        Icon="trash"
                        Text="Limpar pedido"
                        Variant="Ghost" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
