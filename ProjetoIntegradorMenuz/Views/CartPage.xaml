<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ProjetoIntegradorMenuz.Models"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:CartViewModel"
    Title="Seu pedido">

    <Grid
        MaximumWidthRequest="720"
        Padding="20"
        HorizontalOptions="Fill"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16">

        <Button
            Grid.Row="0"
            Command="{Binding GoBackCommand}"
            HorizontalOptions="Start"
            Style="{StaticResource MzGhostButton}"
            Text="&#x2190; Voltar ao cardápio"
            Margin="0,0,0,10" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Cart.Items}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Label
                        FontSize="56"
                        HorizontalOptions="Center"
                        Text="🛒" />
                    <Label
                        HorizontalOptions="Center"
                        Style="{StaticResource MzTitle}"
                        Text="Seu carrinho está vazio" />
                    <Label
                        HorizontalOptions="Center"
                        Style="{StaticResource MzMuted}"
                        Text="Volte ao cardápio e escolha alguns itens." />
                    <Button
                        Margin="0,8,0,0"
                        Command="{Binding GoBackCommand}"
                        HorizontalOptions="Center"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="Voltar ao cardápio" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartItem">
                    <Border Padding="16" Style="{StaticResource MzCard}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="12">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Style="{StaticResource MzName}" Text="{Binding Product.Name}" />
                                <Label Style="{StaticResource MzMuted}" Text="{Binding UnitPrice, StringFormat='{0:C2} cada'}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding BindingContext.RemoveCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding .}"
                                HeightRequest="36"
                                Style="{StaticResource MzGhostButton}"
                                Text="Remover" />

                            <HorizontalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Spacing="12"
                                VerticalOptions="Center">
                                <Button
                                    Command="{Binding BindingContext.DecreaseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource MzQtyButton}"
                                    Text="−" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    MinimumWidthRequest="28"
                                    Style="{StaticResource MzName}"
                                    Text="{Binding Quantity}"
                                    VerticalOptions="Center" />
                                <Button
                                    Command="{Binding BindingContext.IncreaseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource MzQtyButton}"
                                    Text="+" />
                            </HorizontalStackLayout>

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource MzPrice}"
                                Text="{Binding Subtotal, StringFormat='{0:C2}'}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border
            Grid.Row="2"
            Padding="20"
            Style="{StaticResource MzCard}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Style="{StaticResource MzTitle}"
                        Text="Total"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontSize="24"
                        Style="{StaticResource MzPrice}"
                        Text="{Binding Cart.TotalPrice, StringFormat='{0:C2}'}" />
                </Grid>
                <Button
                    HeightRequest="50"
                    x:Name="FinalizarPedido"
                    IsEnabled="True"
                    Clicked="FinalizarPedido_Clicked"
                    Style="{StaticResource MzPrimaryButton}"
                    Text="Finalizar pedido"/>       
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource MzMuted}"
                    Text="O envio para a cozinha será habilitado na próxima etapa (SignalR)." />
                <Button
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource MzGhostButton}"
                    Text="Limpar carrinho" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>