<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ProjetoIntegradorMenuz.Models"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:CartViewModel"
    Title="Seu pedido"
    Shell.NavBarIsVisible="False">

    <!-- A tela tem o próprio botão de voltar; esconde a seta extra que o Windows mostra na barra de título -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Barra superior -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Style="{StaticResource MzAppBar}">
            <Button
                Command="{Binding GoBackCommand}"
                Style="{StaticResource MzQtyButton}"
                Text="←"
                VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzTitle}" Text="Seu pedido" />
                <Label Style="{StaticResource MzMuted}" Text="{Binding Cart.TotalCount, StringFormat='{0} item(ns)'}" />
            </VerticalStackLayout>
            <Border
                Grid.Column="2"
                Padding="14,8"
                BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                IsVisible="{Binding Table.IsConfigured}"
                Style="{StaticResource MzChip}"
                Stroke="Transparent"
                VerticalOptions="Center">
                <Label
                    Style="{StaticResource MzChipLabel}"
                    Text="{Binding Table.DisplayText, StringFormat='🪑  {0}'}"
                    TextColor="{StaticResource MzPrimaryDeep}" />
            </Border>
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <Grid
            x:Name="ContentGrid"
            Grid.Row="2"
            Padding="20"
            ColumnDefinitions="*,360"
            RowDefinitions="*"
            RowSpacing="16"
            ColumnSpacing="20"
            HorizontalOptions="Center"
            MaximumWidthRequest="1100">

            <!-- Itens -->
            <CollectionView ItemsSource="{Binding Cart.Items}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                            HeightRequest="96"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            WidthRequest="96">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="48" />
                            </Border.StrokeShape>
                            <Label FontSize="44" HorizontalOptions="Center" Text="🛒" VerticalOptions="Center" />
                        </Border>
                        <Label HorizontalOptions="Center" Style="{StaticResource MzSection}" Text="Seu carrinho está vazio" />
                        <Label HorizontalOptions="Center" Style="{StaticResource MzMuted}" Text="Volte ao cardápio e escolha alguns itens." />
                        <Button
                            Margin="0,6,0,0"
                            Command="{Binding GoBackCommand}"
                            HorizontalOptions="Center"
                            Style="{StaticResource MzPrimaryButton}"
                            Text="Ver cardápio" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartItem">
                        <Border Padding="18,16" Style="{StaticResource MzCard}">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="16"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Style="{StaticResource MzName}" Text="{Binding DisplayName}" />
                                    <Label
                                        IsVisible="{Binding HasOptions}"
                                        LineBreakMode="WordWrap"
                                        Style="{StaticResource MzMuted}"
                                        Text="{Binding OptionsText}"
                                        TextColor="{StaticResource MzPrimaryDeep}" />
                                    <Label Style="{StaticResource MzMuted}" Text="{Binding UnitPrice, StringFormat='{0:C2} cada'}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Command="{Binding BindingContext.RemoveCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource MzGhostButton}"
                                    Text="Remover"
                                    TextColor="{AppThemeBinding Light={StaticResource MzDestructiveLight}, Dark={StaticResource MzDestructiveDark}}"
                                    VerticalOptions="Start" />

                                <!-- Quantidade -->
                                <Border
                                    Grid.Row="1"
                                    Padding="4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource MzMutedLight}, Dark={StaticResource MzMutedDark}}"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6">
                                        <Button
                                            BackgroundColor="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}"
                                            Command="{Binding BindingContext.DecreaseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="36"
                                            Style="{StaticResource MzQtyButton}"
                                            Text="−"
                                            WidthRequest="36" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            MinimumWidthRequest="28"
                                            Text="{Binding Quantity}"
                                            VerticalOptions="Center" />
                                        <Button
                                            BackgroundColor="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}"
                                            Command="{Binding BindingContext.IncreaseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="36"
                                            Style="{StaticResource MzQtyButton}"
                                            Text="+"
                                            WidthRequest="36" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource MzPrice}"
                                    Text="{Binding Subtotal, StringFormat='{0:C2}'}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Resumo -->
            <Border
                x:Name="SummaryCard"
                Grid.Column="1"
                Padding="22"
                Style="{StaticResource MzCardRaised}"
                VerticalOptions="Start">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource MzSection}" Text="Resumo" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource MzMuted}" Text="Itens" />
                        <Label Grid.Column="1" Style="{StaticResource MzBody}" Text="{Binding Cart.TotalCount}" />
                    </Grid>

                    <BoxView Style="{StaticResource MzDivider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource MzSection}" Text="Total" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontSize="26"
                            Style="{StaticResource MzPrice}"
                            Text="{Binding Cart.TotalPrice, StringFormat='{0:C2}'}" />
                    </Grid>

                    <Button
                        x:Name="FinalizarPedido"
                        Clicked="FinalizarPedido_Clicked"
                        HeightRequest="54"
                        IsEnabled="{Binding IsNotSubmitting}"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="Finalizar pedido" />

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzMuted}"
                        Text="{Binding Table.CartHint}" />

                    <Button
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource MzGhostButton}"
                        Text="Limpar carrinho" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
