<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.ManagerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ProjetoIntegradorMenuz.ViewModels"
    x:DataType="vm:ManagerViewModel"
    Title="Gerência"
    Shell.NavBarIsVisible="False">

    <!-- A tela tem o próprio botão de voltar; esconde a seta extra que o Windows mostra na barra de título -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <!-- Cartão de indicador -->
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource MzCard}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="WidthRequest" Value="220" />
        </Style>
        <Style x:Key="KpiValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
        </Style>

        <!-- Aba do seletor (segmented control) -->
        <Style x:Key="TabItem" TargetType="Border">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzMutedForegroundLight}, Dark={StaticResource MzMutedForegroundDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">

        <!-- Barra superior -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Style="{StaticResource MzAppBar}">
            <Border Style="{StaticResource MzLogo}">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="M"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Style="{StaticResource MzTitle}" Text="Gerência" />
                <Label Style="{StaticResource MzMuted}" Text="{Binding UserText}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource MzOutlineButton}"
                Text="⟳  Atualizar"
                VerticalOptions="Center" />
            <Button
                Grid.Column="3"
                Command="{Binding OpenKitchenCommand}"
                Style="{StaticResource MzOutlineButton}"
                Text="🍳  Cozinha"
                VerticalOptions="Center" />
            <Button
                Grid.Column="4"
                Command="{Binding LogoutCommand}"
                Style="{StaticResource MzSecondaryButton}"
                Text="Sair"
                VerticalOptions="Center" />
        </Grid>
        <BoxView Grid.Row="1" Style="{StaticResource MzDivider}" />

        <!-- Seletor de abas -->
        <Border
            Grid.Row="2"
            Margin="20,16,20,4"
            Padding="4"
            BackgroundColor="{AppThemeBinding Light={StaticResource MzMutedLight}, Dark={StaticResource MzMutedDark}}"
            HorizontalOptions="Start"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="4">
                <Border Style="{StaticResource TabItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Overview" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsOverview}" TargetType="Border" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource TabLabel}" Text="Visão geral">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource TabItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Orders" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsOrders}" TargetType="Border" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource TabLabel}" Text="Pedidos de hoje">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding IsOrders}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource TabItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Tables" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsTables}" TargetType="Border" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource TabLabel}" Text="Mesas abertas">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding IsTables}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource TabItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Users" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsUsers}" TargetType="Border" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource TabLabel}" Text="Usuários">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding IsUsers}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource TabItem}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Menu" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsMenu}" TargetType="Border" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource TabLabel}" Text="Cardápio">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding IsMenu}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </Border>

        <!-- Erro -->
        <Border
            Grid.Row="3"
            Margin="20,10,20,0"
            Padding="14,10"
            BackgroundColor="{StaticResource MzDestructiveTint}"
            IsVisible="{Binding HasError}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Label Style="{StaticResource MzError}" Text="{Binding ErrorMessage}" />
        </Border>

        <Grid Grid.Row="4">

            <!-- ================= Visão geral ================= -->
            <ScrollView IsVisible="{Binding IsOverview}">
                <VerticalStackLayout Padding="20,12,20,40" Spacing="22">

                    <!-- Indicadores do dia -->
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource MzOverline}" Text="Hoje" />
                        <FlexLayout Direction="Row" Wrap="Wrap">
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Faturamento" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding RevenueText}" TextColor="{StaticResource MzPrimaryDeep}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Pedidos" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding OrdersText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Ticket médio" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding TicketText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Em andamento" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding OpenText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Tempo até ficar pronto" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding ReadyText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Tempo até a entrega" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding DeliverText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Cancelados" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding CancelledText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Contas fechadas" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding BillsClosedText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource KpiCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MzMuted}" Text="Ticket médio por conta" />
                                    <Label Style="{StaticResource KpiValue}" Text="{Binding BillTicketText}" />
                                </VerticalStackLayout>
                            </Border>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Mais vendidos -->
                        <Border Padding="20" Style="{StaticResource MzCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Style="{StaticResource MzSection}" Text="Mais vendidos hoje" />
                                <Label
                                    IsVisible="{Binding HasNoTopProducts}"
                                    Style="{StaticResource MzMuted}"
                                    Text="Nenhum pedido hoje ainda." />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopProducts}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TopProductViewModel">
                                            <Grid ColumnDefinitions="30,*,Auto,100" ColumnSpacing="10">
                                                <Border
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                                                    HeightRequest="26"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center"
                                                    WidthRequest="26">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="13" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="12"
                                                        HorizontalOptions="Center"
                                                        Text="{Binding Position}"
                                                        TextColor="{StaticResource MzPrimaryDeep}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="1" Style="{StaticResource MzBody}" Text="{Binding Name}" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Style="{StaticResource MzMuted}" Text="{Binding QuantityText}" VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="3"
                                                    FontFamily="OpenSansSemibold"
                                                    HorizontalTextAlignment="End"
                                                    Text="{Binding RevenueText}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tempo de resposta (REQ. 5) -->
                        <Border Grid.Column="1" Padding="20" Style="{StaticResource MzCard}">
                            <VerticalStackLayout Spacing="14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource MzSection}" Text="Tempo de resposta" />
                                    <Label Style="{StaticResource MzMuted}" Text="Do envio do pedido até aparecer na tela da cozinha." />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Style="{StaticResource MzMuted}" Text="Média" />
                                        <Label Style="{StaticResource KpiValue}" Text="{Binding LatencyAvgText}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Style="{StaticResource MzMuted}" Text="95% até" />
                                        <Label Style="{StaticResource KpiValue}" Text="{Binding LatencyP95Text}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label Style="{StaticResource MzMuted}" Text="Abaixo de 2 s" />
                                        <Label Style="{StaticResource KpiValue}" Text="{Binding LatencyUnderText}" TextColor="{StaticResource MzSuccessText}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Style="{StaticResource MzMuted}" Text="{Binding LatencySamplesText}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Mesa deste tablet -->
                    <Border Padding="20,16" Style="{StaticResource MzCard}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Label FontSize="26" Text="🪑" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Style="{StaticResource MzName}" Text="{Binding Table.DisplayText, StringFormat='Este tablet: {0}'}" />
                                <Label Style="{StaticResource MzMuted}" Text="Os pedidos feitos neste aparelho chegam à cozinha com esse número." />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="2"
                                Command="{Binding ChangeTableCommand}"
                                Style="{StaticResource MzOutlineButton}"
                                Text="Alterar mesa"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ================= Usuários ================= -->
            <CollectionView
                x:Name="UsersList"
                Margin="20,12,20,0"
                IsVisible="{Binding IsUsers}"
                ItemsSource="{Binding Users}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource MzSection}" Text="Usuários da equipe" />
                            <Label Style="{StaticResource MzMuted}" Text="{Binding UsersSummary}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding NewUserCommand}"
                            Style="{StaticResource MzPrimaryButton}"
                            Text="+  Novo usuário"
                            VerticalOptions="Center" />
                    </Grid>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label
                        Margin="0,48"
                        HorizontalOptions="Center"
                        Style="{StaticResource MzMuted}"
                        Text="Nenhum usuário cadastrado." />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="40" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManagerUserViewModel">
                        <Border Padding="18,14" Style="{StaticResource MzCard}">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsInactive}" TargetType="Border" Value="True">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource MzTitle}" Text="{Binding Title}" />
                                    <Label Style="{StaticResource MzMuted}" Text="{Binding Subtitle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="6"
                                    VerticalOptions="Center">
                                    <Border
                                        BackgroundColor="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}"
                                        HorizontalOptions="End"
                                        Style="{StaticResource MzBadge}">
                                        <Label
                                            Style="{StaticResource MzBadgeLabel}"
                                            Text="{Binding RoleText}"
                                            TextColor="{StaticResource MzPrimaryDeep}" />
                                    </Border>
                                    <Label
                                        FontSize="13"
                                        HorizontalOptions="End"
                                        Style="{StaticResource MzMuted}"
                                        Text="{Binding StatusText}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditUserCommand}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="44"
                                    Style="{StaticResource MzOutlineButton}"
                                    Text="Editar"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ================= Mesas abertas ================= -->
            <CollectionView
                x:Name="OpenBillsList"
                Margin="20,12,20,0"
                IsVisible="{Binding IsTables}"
                ItemsSource="{Binding OpenBills}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <VerticalStackLayout Margin="0,0,0,12" Spacing="2">
                        <Label Style="{StaticResource MzSection}" Text="Contas abertas por mesa" />
                        <Label Style="{StaticResource MzMuted}" Text="{Binding OpenBillsSummary}" />
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label
                        Margin="0,48"
                        HorizontalOptions="Center"
                        Style="{StaticResource MzMuted}"
                        Text="Nenhuma mesa com conta aberta." />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="40" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpenBillViewModel">
                        <Border Padding="18,14" Style="{StaticResource MzCard}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Style="{StaticResource MzTitle}" Text="{Binding Title}" />
                                    <Label Style="{StaticResource MzMuted}" Text="{Binding Subtitle}" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        IsVisible="{Binding HasInProgress}"
                                        Text="{Binding InProgressText}"
                                        TextColor="{StaticResource MzWarningText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    Spacing="8"
                                    VerticalOptions="Center">
                                    <Label
                                        FontSize="22"
                                        HorizontalOptions="End"
                                        Style="{StaticResource MzPrice}"
                                        Text="{Binding TotalText}" />
                                    <Button
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CloseOpenBillCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="44"
                                        IsEnabled="{Binding CanClose}"
                                        Style="{StaticResource MzPrimaryButton}"
                                        Text="Encerrar conta" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ================= Pedidos de hoje ================= -->
            <CollectionView
                Margin="20,12,20,0"
                IsVisible="{Binding IsOrders}"
                ItemsSource="{Binding Orders}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label
                        Margin="0,48"
                        HorizontalOptions="Center"
                        Style="{StaticResource MzMuted}"
                        Text="Nenhum pedido hoje ainda." />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="40" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderCardViewModel">
                        <Border Padding="20,16" Style="{StaticResource MzCard}">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsCancelled}" TargetType="Border" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                                <HorizontalStackLayout Spacing="12">
                                    <Label Style="{StaticResource MzSection}" Text="{Binding Title}" VerticalOptions="Center" />
                                    <Border Style="{StaticResource MzBadge}">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsPending}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPreparing}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzWarningTint}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReady}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzSuccessTint}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCancelled}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzDestructiveTint}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Style="{StaticResource MzBadgeLabel}" Text="{Binding StatusText}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzPrimaryDeep}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPreparing}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzWarningText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsReady}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzSuccessText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCancelled}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzDestructiveLight}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Label Style="{StaticResource MzMuted}" Text="{Binding Subtitle}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource MzPrice}"
                                    Text="{Binding Total, StringFormat='{0:C2}'}"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding Lines}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OrderLineViewModel">
                                            <VerticalStackLayout>
                                                <Label Style="{StaticResource MzBody}" Text="{Binding Text}" />
                                                <Label
                                                    IsVisible="{Binding HasDetails}"
                                                    Style="{StaticResource MzMuted}"
                                                    Text="{Binding Details}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsVisible="{Binding IsOpen}"
                                    Spacing="10"
                                    VerticalOptions="End">
                                    <Button
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CancelOrderCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource MzDangerButton}"
                                        Text="Cancelar" />
                                    <Button
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AdvanceOrderCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="42"
                                        Style="{StaticResource MzPrimaryButton}"
                                        Text="{Binding ActionText}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ================= Cardápio ================= -->
            <Grid IsVisible="{Binding IsMenu}" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Padding="20,12,20,4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Style="{StaticResource MzSection}" Text="Produtos" />
                        <Label Style="{StaticResource MzMuted}" Text="Toque no selo para marcar como esgotado ou disponível." />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Command="{Binding EditCategoryCommand}"
                        IsVisible="{Binding HasCategorySelected}"
                        Style="{StaticResource MzOutlineButton}"
                        Text="Editar categoria"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding NewCategoryCommand}"
                        Style="{StaticResource MzOutlineButton}"
                        Text="+ Categoria"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding NewProductCommand}"
                        Style="{StaticResource MzPrimaryButton}"
                        Text="+ Novo produto"
                        VerticalOptions="Center" />
                </Grid>

                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <HorizontalStackLayout
                        Padding="20,10"
                        BindableLayout.ItemsSource="{Binding CategoryFilters}"
                        Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryFilterViewModel">
                                <Border Padding="16,8" Style="{StaticResource MzChip}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.FilterCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Style="{StaticResource MzChipLabel}" Text="{Binding Text}">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource MzOnPrimary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <CollectionView
                    Grid.Row="2"
                    Margin="20,4,20,0"
                    ItemsSource="{Binding Products}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label
                            Margin="0,48"
                            HorizontalOptions="Center"
                            Style="{StaticResource MzMuted}"
                            Text="Nenhum produto nesta categoria." />
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="40" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ManagerProductViewModel">
                            <Border Padding="18,14" Style="{StaticResource MzCard}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Style="{StaticResource MzName}" Text="{Binding Name}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" TargetType="Label" Value="False">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Style="{StaticResource MzMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding CategoryName}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding OptionsText}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource MzPrice}"
                                        Text="{Binding PriceText}"
                                        VerticalOptions="Center" />
                                    <!-- Disponível / esgotado: um toque alterna -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="12,6"
                                        BackgroundColor="{StaticResource MzDestructiveTint}"
                                        Style="{StaticResource MzBadge}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleAvailabilityCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MzSuccessTint}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label
                                            Style="{StaticResource MzBadgeLabel}"
                                            Text="{Binding AvailabilityText}"
                                            TextColor="{StaticResource MzDestructiveLight}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource MzSuccessText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditProductCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource MzOutlineButton}"
                                        Text="Editar"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <ActivityIndicator
                Margin="0,24,0,0"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>
