<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoIntegradorMenuz.Views.PaymentDonePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls"
    Title="Pagamento realizado"
    Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid Padding="24">
        <Border
            Padding="40"
            HorizontalOptions="Center"
            MaximumWidthRequest="440"
            Style="{StaticResource MzCard}"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="20">
                <Border
                    BackgroundColor="{DynamicResource MzSuccessSoft}"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="64">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <controls:MzIcon
                        Color="{DynamicResource MzSuccessText}"
                        Name="check"
                        Size="30" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzTitle}"
                        Text="Pagamento confirmado" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource MzMuted}"
                        Text="Obrigado pela visita." />
                </VerticalStackLayout>

                <!-- Recibo -->
                <Border
                    Padding="16"
                    BackgroundColor="{DynamicResource MzSurfaceSunken}"
                    Stroke="{DynamicResource MzBorder}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource MzMuted}" Text="Mesa" />
                            <Label x:Name="TableLabel" Grid.Column="1" Style="{StaticResource MzStrong}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource MzMuted}" Text="Forma de pagamento" />
                            <Label Grid.Column="1" Style="{StaticResource MzStrong}" Text="Simulado" />
                        </Grid>
                        <BoxView Style="{StaticResource MzDivider}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource MzStrong}" Text="Total pago" VerticalOptions="Center" />
                            <Label
                                x:Name="AmountLabel"
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                FontSize="20" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button
                    Clicked="VoltarMenu_Clicked"
                    Style="{StaticResource MzPrimaryButton}"
                    Text="Concluir" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
