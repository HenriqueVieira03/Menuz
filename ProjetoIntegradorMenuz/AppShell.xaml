<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProjetoIntegradorMenuz.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProjetoIntegradorMenuz.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}"
    Title="Menuz">

    <ShellContent
        Title="Cardápio"
        ContentTemplate="{DataTemplate views:MenuPage}"
        Route="MenuPage" />

</Shell>
