<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls">

    <!-- =====================================================================
         IDENTIDADE VISUAL MENUZ
         Paleta herdada do Fournos (globals.css). Para ajustar cores, raios
         ou tipografia do app inteiro, edite somente este arquivo.
         ===================================================================== -->

    <!-- ============================ CORES ============================ -->

    <!-- Claro -->
    <Color x:Key="MzBackgroundLight">#F4F4EB</Color>
    <Color x:Key="MzForegroundLight">#532718</Color>
    <Color x:Key="MzCardLight">#FFFFFF</Color>
    <Color x:Key="MzBorderLight">#E2D3C5</Color>
    <Color x:Key="MzInputBorderLight">#D6C3B2</Color>
    <Color x:Key="MzMutedLight">#EFE7DC</Color>
    <Color x:Key="MzMutedForegroundLight">#6B4F43</Color>
    <Color x:Key="MzPrimaryLight">#F77F00</Color>
    <Color x:Key="MzPrimaryTintLight">#FFF4E6</Color>

    <!-- Escuro -->
    <Color x:Key="MzBackgroundDark">#1A0E0A</Color>
    <Color x:Key="MzForegroundDark">#F4F4EB</Color>
    <Color x:Key="MzCardDark">#2A1A14</Color>
    <Color x:Key="MzBorderDark">#3A261F</Color>
    <Color x:Key="MzMutedDark">#3A261F</Color>
    <Color x:Key="MzMutedForegroundDark">#CBB7AA</Color>
    <Color x:Key="MzPrimaryDark">#FF8C1A</Color>
    <Color x:Key="MzPrimaryTintDark">#3A2212</Color>

    <!-- Comuns -->
    <Color x:Key="MzOnPrimary">#FFFFFF</Color>
    <Color x:Key="MzPrimaryDeep">#CC6600</Color>
    <Color x:Key="MzSecondary">#A5530C</Color>
    <Color x:Key="MzSuccess">#6BAF6B</Color>
    <Color x:Key="MzSuccessTint">#EAF4EA</Color>
    <Color x:Key="MzSuccessText">#3E7B3E</Color>
    <Color x:Key="MzWarningTint">#FDF0D5</Color>
    <Color x:Key="MzWarningText">#9A5B00</Color>
    <Color x:Key="MzDestructiveLight">#D64527</Color>
    <Color x:Key="MzDestructiveDark">#FF8A65</Color>
    <Color x:Key="MzDestructiveTint">#FBE9E5</Color>
    <Color x:Key="MzScrim">#99000000</Color>

    <!-- Sombra suave usada nos elementos flutuantes (barra do carrinho, popup, cartões de destaque) -->
    <Shadow
        x:Key="MzShadow"
        Brush="#532718"
        Opacity="0.10"
        Radius="18"
        Offset="0,6" />

    <!-- ============================ PÁGINA ============================ -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzBackgroundLight}, Dark={StaticResource MzBackgroundDark}}" />
    </Style>

    <!-- ========================= TIPOGRAFIA ========================== -->
    <!-- Escala: Display 28 · Título 22 · Seção 18 · Nome 16 · Corpo 15 · Legenda 13 · Rótulo 12 -->

    <Style x:Key="MzDisplay" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzSection" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzName" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzBody" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzMutedForegroundLight}, Dark={StaticResource MzMutedForegroundDark}}" />
    </Style>
    <!-- Rótulo de seção em caixa alta, discreto (ex.: "TAMANHO", "INDICADORES") -->
    <Style x:Key="MzOverline" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzMutedForegroundLight}, Dark={StaticResource MzMutedForegroundDark}}" />
    </Style>
    <!-- Rótulo de campo de formulário -->
    <Style x:Key="MzFieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzPrice" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
    </Style>
    <Style x:Key="MzChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
    </Style>
    <Style x:Key="MzError" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzDestructiveLight}, Dark={StaticResource MzDestructiveDark}}" />
    </Style>

    <!-- ===================== SUPERFÍCIES ===================== -->

    <Style x:Key="MzCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzBorderLight}, Dark={StaticResource MzBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão com sombra, para blocos de destaque (não usar em listas longas) -->
    <Style x:Key="MzCardRaised" TargetType="Border" BasedOn="{StaticResource MzCard}">
        <Setter Property="Shadow" Value="{StaticResource MzShadow}" />
    </Style>

    <!-- Chip / pílula selecionável (categorias, filtros, opções) -->
    <Style x:Key="MzChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzBorderLight}, Dark={StaticResource MzBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="999" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selo de status (Novo, Em preparo, Pronto...) -->
    <Style x:Key="MzBadge" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzMutedLight}, Dark={StaticResource MzMutedDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="999" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MzBadgeLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzMutedForegroundLight}, Dark={StaticResource MzMutedForegroundDark}}" />
    </Style>

    <!-- Barra superior das telas -->
    <Style x:Key="MzAppBar" TargetType="Grid">
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="MinimumHeightRequest" Value="68" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
    </Style>
    <Style x:Key="MzDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource MzBorderLight}, Dark={StaticResource MzBorderDark}}" />
    </Style>

    <!-- Logotipo "M" -->
    <Style x:Key="MzLogo" TargetType="Border">
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F77F00" />
                    <GradientStop Offset="1" Color="#CC6600" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CAMPOS DE FORMULÁRIO ===================== -->
    <!-- Uso: <Border Style="{StaticResource MzInput}"><Entry ... /></Border>
         A moldura destaca em laranja quando o campo recebe foco (Controls/FocusRing.cs). -->

    <Style x:Key="MzInput" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MzInputBorderLight}, Dark={StaticResource MzBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#A08B80, Dark=#8C776B}" />
        <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#A08B80, Dark=#8C776B}" />
        <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#A08B80, Dark=#8C776B}" />
        <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light=#FBC48A, Dark=#7A4A1E}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
    </Style>

    <!-- ============================ BOTÕES ============================ -->

    <!-- Ação principal da tela -->
    <Style x:Key="MzPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryLight}, Dark={StaticResource MzPrimaryDark}}" />
        <Setter Property="TextColor" Value="{StaticResource MzOnPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Ação secundária: fundo claro alaranjado, texto laranja -->
    <Style x:Key="MzSecondaryButton" TargetType="Button" BasedOn="{StaticResource MzPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryTintLight}, Dark={StaticResource MzPrimaryTintDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzPrimaryDeep}, Dark={StaticResource MzPrimaryDark}}" />
    </Style>

    <!-- Contorno neutro: ações de apoio (Atualizar, Editar, Cancelar) -->
    <Style x:Key="MzOutlineButton" TargetType="Button" BasedOn="{StaticResource MzPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzCardLight}, Dark={StaticResource MzCardDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource MzInputBorderLight}, Dark={StaticResource MzBorderDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Destrutivo (cancelar pedido, excluir) -->
    <Style x:Key="MzDangerButton" TargetType="Button" BasedOn="{StaticResource MzOutlineButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzDestructiveLight}, Dark={StaticResource MzDestructiveDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light=#F0C2B8, Dark=#5A2A20}" />
    </Style>

    <!-- Texto sem fundo -->
    <Style x:Key="MzGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzMutedForegroundLight}, Dark={StaticResource MzMutedForegroundDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Botão quadrado de ícone (voltar, +, −, ✕) -->
    <Style x:Key="MzQtyButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MzMutedLight}, Dark={StaticResource MzMutedDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MzForegroundLight}, Dark={StaticResource MzForegroundDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
</ResourceDictionary>
