<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ProjetoIntegradorMenuz.Controls">

    <!-- =====================================================================
         SISTEMA VISUAL MENUZ

         CORES: tokens semânticos (MzBackground, MzText, MzPrimary...). Os valores
         abaixo são o padrão (tema claro, laranja Menuz); o ThemeService os troca em
         tempo de execução conforme a aparência escolhida pela gerência. Por isso as
         telas usam {DynamicResource Mz...}, nunca StaticResource, para cores.

         MEDIDAS: espaçamento em múltiplos de 4; raio 8 em controles, 12 em cartões.
         TIPOGRAFIA: Open Sans. 24 título de página · 18 seção · 15 destaque · 14 corpo · 12 legenda.
         ===================================================================== -->

    <!-- ============================ CORES (padrão) ============================ -->
    <Color x:Key="MzBackground">#F4F4EB</Color>
    <Color x:Key="MzSurface">#FFFFFF</Color>
    <Color x:Key="MzSurfaceAlt">#EFE7DC</Color>
    <Color x:Key="MzSurfaceSunken">#F8F5EE</Color>
    <Color x:Key="MzBorder">#E6D9CC</Color>
    <Color x:Key="MzBorderStrong">#D6C3B2</Color>
    <Color x:Key="MzText">#532718</Color>
    <Color x:Key="MzTextMuted">#6B4F43</Color>
    <Color x:Key="MzTextSubtle">#A08B80</Color>

    <Color x:Key="MzSidebar">#3B1C11</Color>
    <Color x:Key="MzSidebarText">#F4EDE6</Color>
    <Color x:Key="MzSidebarMuted">#C9B3A6</Color>
    <Color x:Key="MzSidebarActive">#26FFFFFF</Color>

    <Color x:Key="MzPrimary">#F77F00</Color>
    <Color x:Key="MzPrimaryStrong">#C25F00</Color>
    <Color x:Key="MzPrimarySoft">#FFF1E0</Color>
    <Color x:Key="MzOnPrimary">#FFFFFF</Color>

    <Color x:Key="MzSuccess">#4E9A4E</Color>
    <Color x:Key="MzSuccessSoft">#E8F3E8</Color>
    <Color x:Key="MzSuccessText">#2F6B2F</Color>
    <Color x:Key="MzWarning">#E19A2B</Color>
    <Color x:Key="MzWarningSoft">#FBEFD8</Color>
    <Color x:Key="MzWarningText">#8A5300</Color>
    <Color x:Key="MzDanger">#C93C20</Color>
    <Color x:Key="MzDangerSoft">#FBE9E5</Color>
    <Color x:Key="MzDangerText">#B3341B</Color>
    <Color x:Key="MzDangerBorder">#F0C9C0</Color>

    <Color x:Key="MzTransparent">Transparent</Color>
    <Color x:Key="MzScrim">#8C1A0E0A</Color>

    <!-- Sombra só para o que flutua (diálogos, barra do pedido) -->
    <Shadow
        x:Key="MzShadow"
        Brush="#1A0E0A"
        Opacity="0.16"
        Radius="24"
        Offset="0,8" />

    <!-- ============================ IMPLÍCITOS ============================ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource MzBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource MzPrimary}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource MzPrimary}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource MzPrimary}" />
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <Style TargetType="controls:MzIcon">
        <Setter Property="Color" Value="{DynamicResource MzText}" />
    </Style>

    <!-- ============================ TIPOGRAFIA ============================ -->

    <Style x:Key="MzPageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzSection" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzName" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzBody" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzStrong" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource MzTextMuted}" />
    </Style>
    <Style x:Key="MzCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource MzTextMuted}" />
    </Style>
    <!-- Cabeçalho de tabela / rótulo de grupo -->
    <Style x:Key="MzColumnHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{DynamicResource MzTextSubtle}" />
    </Style>
    <Style x:Key="MzFieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzPrice" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzMetric" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
    </Style>
    <Style x:Key="MzError" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource MzDangerText}" />
    </Style>

    <!-- ============================ SUPERFÍCIES ============================ -->

    <Style x:Key="MzCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource MzBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MzDialog" TargetType="Border" BasedOn="{StaticResource MzCard}">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Shadow" Value="{StaticResource MzShadow}" />
    </Style>

    <!-- Aba / filtro selecionável (o estado selecionado é aplicado por DataTrigger nas telas) -->
    <Style x:Key="MzChip" TargetType="Border">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource MzBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MzChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource MzTextMuted}" />
    </Style>

    <!-- Selo de status -->
    <Style x:Key="MzBadge" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurfaceAlt}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MzBadgeLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource MzTextMuted}" />
    </Style>

    <!-- Barra superior -->
    <Style x:Key="MzAppBar" TargetType="Grid">
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurface}" />
    </Style>
    <Style x:Key="MzDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource MzBorder}" />
    </Style>
    <Style x:Key="MzVDivider" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource MzBorder}" />
    </Style>

    <!-- Marca: quadrado com a inicial do estabelecimento -->
    <Style x:Key="MzLogo" TargetType="Border">
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="{DynamicResource MzPrimary}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MzLogoLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource MzOnPrimary}" />
    </Style>

    <!-- Estado vazio: círculo suave com ícone -->
    <Style x:Key="MzEmptyIcon" TargetType="Border">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurfaceAlt}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="32" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ FORMULÁRIOS ============================ -->
    <!-- Uso: <Border Style="{StaticResource MzInput}"><Entry ... /></Border>
         A moldura fica na cor de destaque quando o campo tem foco (Controls/FocusRing.cs). -->

    <Style x:Key="MzInput" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource MzBorderStrong}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource MzTextSubtle}" />
        <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource MzTextSubtle}" />
        <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
        <Setter Property="TitleColor" Value="{DynamicResource MzTextSubtle}" />
        <Setter Property="controls:FocusRing.IsEnabled" Value="True" />
    </Style>

    <!-- ============================ BOTÕES (texto) ============================
         Para botões com ícone use controls:MzButton. Estes são para ações só de texto
         que precisam do evento Clicked (Finalizar pedido, Pagar...). -->

    <Style x:Key="MzPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource MzPrimary}" />
        <Setter Property="TextColor" Value="{DynamicResource MzOnPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="MzOutlineButton" TargetType="Button" BasedOn="{StaticResource MzPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource MzSurface}" />
        <Setter Property="TextColor" Value="{DynamicResource MzText}" />
        <Setter Property="BorderColor" Value="{DynamicResource MzBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="MzGhostButton" TargetType="Button" BasedOn="{StaticResource MzPrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource MzTextMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
</ResourceDictionary>
