<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta do Fournos (globals.css) -->

    <!-- ===== LIGHT ===== -->
    <Color x:Key="LightBackground">#F4F4EB</Color>
    <Color x:Key="LightForeground">#532718</Color>
    <Color x:Key="LightCard">#FFFFFF</Color>
    <Color x:Key="LightPrimary">#F77F00</Color>
    <Color x:Key="LightSecondary">#A5530C</Color>
    <Color x:Key="LightMuted">#EFE7DC</Color>
    <Color x:Key="LightMutedForeground">#6B4F43</Color>
    <Color x:Key="LightBorder">#E2D3C5</Color>
    <Color x:Key="LightDestructive">#D64527</Color>
    <Color x:Key="LightSuccess">#6BAF6B</Color>

    <!-- ===== DARK ===== -->
    <Color x:Key="DarkBackground">#1A0E0A</Color>
    <Color x:Key="DarkForeground">#F4F4EB</Color>
    <Color x:Key="DarkCard">#2A1A14</Color>
    <Color x:Key="DarkPrimary">#FF8C1A</Color>
    <Color x:Key="DarkSecondary">#A5530C</Color>
    <Color x:Key="DarkMuted">#3A261F</Color>
    <Color x:Key="DarkMutedForeground">#CBB7AA</Color>
    <Color x:Key="DarkBorder">#3A261F</Color>
    <Color x:Key="DarkDestructive">#FF8A65</Color>
    <Color x:Key="DarkSuccess">#81C784</Color>

    <!-- Fixos -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="OnPrimaryGlass">#33FFFFFF</Color>
</ResourceDictionary>
